# Oath x86_64 kernel fragment. Merged onto `defconfig` by image/build-linux.sh.
# Drivers we pack (initrd MODULE_ROOTS) plus EFI stub, 32-bit Steam, canto metal.
# Not a distro generic config.

CONFIG_EXPERT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KEXEC=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_EARLY_PRINTK_EFI=y
CONFIG_X86_VERBOSE_BOOTUP=y

# EFI LoadImage / oath-efi
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFI_VARS_PSTORE=n
CONFIG_EFIVAR_FS=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CGROUPS=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETFILTER=n

# Steam 32-bit ubuntu12 ELF
CONFIG_IA32_EMULATION=y
CONFIG_COMPAT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_ACPI=y
CONFIG_ACPI_VIDEO=m
CONFIG_X86_INTEL_LPSS=y

# Block / canto Apple SSD + virtio
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_ATA=m
CONFIG_SATA_AHCI=m
CONFIG_SATA_AHCI_PLATFORM=n
CONFIG_BLK_DEV_NVME=m
CONFIG_NVME_CORE=m

# Net: canto Broadcom tg3 + QEMU virtio + common NICs
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_PHYLIB=m
CONFIG_MDIO_DEVICE=m
CONFIG_PTP_1588_CLOCK=m
CONFIG_PPS=m

# Virtio (QEMU probe)
CONFIG_VIRTIO=m
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_HW_RANDOM=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_VIRTIO_DMA_BUF=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_SND_VIRTIO=m
CONFIG_FW_CFG_SYSFS=m

# DRM / Pitcairn SI + virtio-gpu
CONFIG_DRM=m
CONFIG_DRM_KMS_HELPER=m
CONFIG_DRM_TTM=m
CONFIG_DRM_BUDDY=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_RADEON=n
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VGA_CONSOLE=y
CONFIG_I2C=m
CONFIG_I2C_ALGOBIT=m
CONFIG_HWMON=m

# HID / USB (Magic Keyboard, Razer)
CONFIG_USB=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_EHCI_PCI=m
CONFIG_USB_OHCI_HCD=n
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_HID_APPLE=m
CONFIG_USB_HID=m
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=m
CONFIG_INPUT_MOUSEDEV=n

# Sound: canto Cirrus HDA + Pitcairn HDMI
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m

# Filesystems
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XOR_BLOCKS=m
CONFIG_RAID6_PQ=m
CONFIG_CRYPTO_CRC32C=m
CONFIG_LIBCRC32C=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_UTF8=m
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_NFS_V4_1=y
CONFIG_SUNRPC=m
CONFIG_LOCKD=m
CONFIG_NETWORK_FILESYSTEMS=y

CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_EXTRA_FIRMWARE=""

# Uncompressed modules: pack.rs stores .ko
# CONFIG_MODULE_COMPRESS_XZ is not set
# CONFIG_MODULE_COMPRESS_ZSTD is not set
