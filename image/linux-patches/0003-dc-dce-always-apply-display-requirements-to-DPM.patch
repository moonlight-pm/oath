From: Oath <oath@local>
Subject: 0003-dc-dce-always-apply-display-requirements-to-DPM.patch

--- a/drivers/gpu/drm/amd/display/dc/clk_mgr/dce100/dce_clk_mgr.c
+++ b/drivers/gpu/drm/amd/display/dc/clk_mgr/dce100/dce_clk_mgr.c
@@ -322,8 +322,12 @@
 
 	dce110_fill_display_configs(context, pp_display_cfg);
 
-	if (memcmp(&dc->current_state->pp_display_cfg, pp_display_cfg, sizeof(*pp_display_cfg)) !=  0)
-		dm_pp_apply_display_requirements(dc->ctx, pp_display_cfg);
+	/*
+	 * Always notify DPM. memcmp against current_state is a no-op when
+	 * context == current_state (fill mutates the same buffer), so SI
+	 * SMC would stay on NoDisplay boot clocks (300/150 MHz).
+	 */
+	dm_pp_apply_display_requirements(dc->ctx, pp_display_cfg);
 }
 
 static void dce_update_clocks(struct clk_mgr *clk_mgr_base,
