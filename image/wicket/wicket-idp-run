#!/bin/sh
# First-boot IdP. Mint the cookie secret once, then exec the packed binary.
set -e
STATE="${WICKET_STATE_DIR:-/var/lib/wicket}"
IDP="$STATE/idp"
mkdir -p "$IDP"
SECRETS="$IDP/secrets.env"
if [ ! -f "$SECRETS" ]; then
    umask 077
    if ! secret=$(dd if=/dev/urandom bs=64 count=1 2>/dev/null | base64 | tr -d '\n'); then
        echo "wicket-idp-run: base64 is required to mint the cookie secret" >&2
        exit 1
    fi
    token=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 | tr -d '\n')
    printf 'WICKET_IDP_COOKIE_SECRET=%s\nWICKET_IDP_ADMIN_TOKEN=%s\n' "$secret" "$token" > "$SECRETS"
fi
set -a
# shellcheck disable=SC1090
. "$SECRETS"
if [ -f "$IDP/runtime.env" ]; then
    # shellcheck disable=SC1090
    . "$IDP/runtime.env"
fi
if [ -f "$IDP/mail.env" ]; then
    # shellcheck disable=SC1090
    . "$IDP/mail.env"
fi
set +a
: "${WICKET_IDP_BIND_ADDR:=127.0.0.1:8081}"
: "${WICKET_IDP_UI_BIND_ADDR:=127.0.0.1:8091}"
: "${WICKET_IDP_ISSUER:=http://127.0.0.1:8081}"
: "${WICKET_IDP_RP_ID:=localhost}"
: "${WICKET_IDP_RP_ORIGIN:=http://127.0.0.1:8081}"
: "${WICKET_IDP_SECURE_COOKIES:=false}"
: "${WICKET_IDP_DATABASE_URL:=sqlite://$IDP/idp.db?mode=rwc}"
: "${WICKET_IDP_CLIENTS:=[]}"
export WICKET_IDP_BIND_ADDR WICKET_IDP_UI_BIND_ADDR WICKET_IDP_ISSUER
export WICKET_IDP_RP_ID WICKET_IDP_RP_ORIGIN WICKET_IDP_SECURE_COOKIES
export WICKET_IDP_DATABASE_URL WICKET_IDP_CLIENTS
export WICKET_IDP_COOKIE_SECRET WICKET_IDP_ADMIN_TOKEN
if [ -f "$IDP/clients.json" ]; then
    WICKET_IDP_CLIENTS=$(cat "$IDP/clients.json")
    export WICKET_IDP_CLIENTS
fi
exec /bin/wicket-idp serve
