#!/bin/sh
# Workload Postgres on @appdata. PID 1 does not start this until that mount exists.
set -e
if [ -x /oath/store/pkg/postgresql/bin/postgres ]; then
    export PATH="/oath/store/pkg/postgresql/bin:$PATH"
    if [ -e /oath/store/pkg/postgresql/lib/libpq.so ]; then
        export LD_LIBRARY_PATH="/oath/store/pkg/postgresql/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
fi
# Postgres finds share/ and lib/ from argv0. The pack copies the Nix
# wrapper onto /bin, and that argv0 looks for /share. Follow the pack
# symlink to the store binary.
pg() {
    name=$1
    fallback=/bin/$name
    link=/oath/store/pkg/postgresql/bin/$name
    if [ ! -e "$link" ]; then
        printf '%s\n' "$fallback"
        return
    fi
    target=$(/bin/busybox readlink -f "$link" 2>/dev/null || true)
    dir=$(/bin/busybox dirname "$target")
    wrapped=$dir/.$name-wrapped
    if [ -e "$wrapped" ]; then
        real=$(/bin/busybox readlink -f "$wrapped" 2>/dev/null || true)
        case "$real" in
            /nix/store/*)
                printf '%s\n' "$real"
                return
                ;;
        esac
    fi
    case "$target" in
        /nix/store/*/bin/$name)
            printf '%s\n' "$target"
            return
            ;;
    esac
    printf '%s\n' "$fallback"
}
ROOT=/var/lib/wicket-appdata/postgres
DATA="$ROOT/data"
RUN="$ROOT/run"
mkdir -p "$DATA" "$RUN"
if [ ! -f "$DATA/PG_VERSION" ]; then
    "$(pg initdb)" -D "$DATA" --encoding=UTF8 --locale=C --auth-local=peer --auth-host=reject
fi
cat > "$DATA/pg_ident.conf" <<'EOF'
wicket home wicket
EOF
cat > "$DATA/pg_hba.conf" <<'EOF'
local all home peer
local all wicket peer map=wicket
local all all scram-sha-256
EOF
"$(pg postgres)" -D "$DATA" -k "$RUN" -c listen_addresses= -c unix_socket_permissions=0777 -c unix_socket_directories="$RUN" &
pid=$!
trap 'kill "$pid" 2>/dev/null; wait "$pid"' TERM INT
i=0
while [ "$i" -lt 50 ]; do
    if [ -S "$RUN/.s.PGSQL.5432" ]; then
        break
    fi
    i=$((i + 1))
    sleep 0.2
done
"$(pg psql)" -h "$RUN" -U home -d postgres -v ON_ERROR_STOP=1 -c "DO \$\$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'wicket') THEN CREATE ROLE wicket SUPERUSER LOGIN; END IF; END \$\$;" || true
"$(pg psql)" -h "$RUN" -U home -d template1 -c "CREATE EXTENSION IF NOT EXISTS postgis;" || true
wait "$pid"
