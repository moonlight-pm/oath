#!/bin/sh
# Workload Postgres on @appdata. PID 1 does not start this until that mount exists.
set -e
if [ -x /oath/store/pkg/postgresql/bin/postgres ]; then
    export PATH="/oath/store/pkg/postgresql/bin:$PATH"
    if [ -e /oath/store/pkg/postgresql/lib/libpq.so ]; then
        export LD_LIBRARY_PATH="/oath/store/pkg/postgresql/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
fi
ROOT=/var/lib/wicket-appdata/postgres
DATA="$ROOT/data"
RUN="$ROOT/run"
mkdir -p "$DATA" "$RUN"
if [ ! -f "$DATA/PG_VERSION" ]; then
    /bin/initdb -D "$DATA" --encoding=UTF8 --locale=C --auth-local=peer --auth-host=reject
fi
cat > "$DATA/pg_ident.conf" <<'EOF'
wicket home wicket
EOF
cat > "$DATA/pg_hba.conf" <<'EOF'
local all home peer
local all wicket peer map=wicket
local all all scram-sha-256
EOF
/bin/postgres -D "$DATA" -k "$RUN" -c listen_addresses= -c unix_socket_permissions=0777 -c unix_socket_directories="$RUN" &
pid=$!
trap 'kill "$pid" 2>/dev/null; wait "$pid"' TERM INT
i=0
while [ "$i" -lt 50 ]; do
    if [ -S "$RUN/.s.PGSQL.5432" ]; then
        break
    fi
    i=$((i + 1))
    sleep 0.2
done
/bin/psql -h "$RUN" -U home -d postgres -v ON_ERROR_STOP=1 -c "DO \$\$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'wicket') THEN CREATE ROLE wicket SUPERUSER LOGIN; END IF; END \$\$;" || true
/bin/psql -h "$RUN" -U home -d template1 -c "CREATE EXTENSION IF NOT EXISTS postgis;" || true
wait "$pid"
