{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Edit(pkgs/**)",
      "Edit(build/audit/**)",
      "Bash(cargo make audit:*)",
      "Bash(cargo make advisories:*)",
      "Bash(cargo make pkgs:*)",
      "Bash(cargo make build:*)",
      "Bash(cargo make check:*)",
      "Bash(cargo make publish:*)",
      "Bash(cargo test -p oath-make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git push origin master)",
      "Bash(git clone --depth:*)",
      "Bash(git -C build/audit/src:*)",
      "Bash(curl -fsSL:*)",
      "Bash(sha256sum:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(date:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(oath:*)",
      "Bash(cargo make install:*)",
      "Bash(cargo make update:*)",
      "Bash(cargo make esp:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset:*)",
      "Edit(pkgs/keys/**)",
      "Edit(check/**)",
      "Edit(.claude/**)",
      "Edit(crates/**)"
    ],
    "defaultMode": "dontAsk"
  }
}
