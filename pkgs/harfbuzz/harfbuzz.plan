#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/harfbuzz/
SRC=/oath/store/pkg/harfbuzz-src/sha256-e67a3482ad18da6ee860197d60035b626f4d4a30401b8c789829ab4947af2858/src
FILES=/oath/store/pkg/harfbuzz-src/sha256-e67a3482ad18da6ee860197d60035b626f4d4a30401b8c789829ab4947af2858/files
SOURCES='harfbuzz-14.6.0.tar.xz'
VERSION=14.6.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/harfbuzz/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "harfbuzz",
    "purl": "pkg:github/harfbuzz/harfbuzz@14.6.0",
    "version": "14.6.0"
  }
]
OATH_EOF
# libharfbuzz with FreeType and GLib; no ICU, cairo, subset, raster or
# utilities. Python scripts the build runs are made non-executable, so
# meson runs them with its own python.
tar -xf "$SRC/$SOURCES"
cd "harfbuzz-$VERSION"
find . -name '*.py' -exec chmod -x {} +
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release --wrap-mode=nodownload \
	-Dfreetype=enabled -Dglib=enabled -Dgobject=disabled -Dcairo=disabled -Dchafa=disabled \
	-Dpng=disabled -Dzlib=disabled -Dicu=disabled -Dgraphite2=disabled -Dfontations=disabled \
	-Dharfrust=disabled -Dkbts=disabled -Dwasm=disabled -Draster=disabled -Dvector=disabled \
	-Dgpu=disabled -Dgpu_demo=disabled -Dsubset=disabled -Dtests=disabled \
	-Dintrospection=disabled -Ddocs=disabled -Dutilities=disabled -Dbenchmark=disabled
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
rm -rf /out/lib/cmake
