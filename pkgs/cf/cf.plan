#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/cf/
SRC=/oath/store/pkg/cf-src/sha256-ff6a506eceb7996796cb2cea95f4125f61ff4d36fa4009002173f51a2ed3cf10/src
FILES=/oath/store/pkg/cf-src/sha256-ff6a506eceb7996796cb2cea95f4125f61ff4d36fa4009002173f51a2ed3cf10/files
SOURCES='npm/@cloudflare/build-output-utils-0.9.6.tgz npm/@cloudflare/config-0.29.0.tgz npm/@cloudflare/runtime-types-0.1.19.tgz npm/@cloudflare/workerd-linux-64-1.20261023.1.tgz npm/@cspotcode/source-map-support-0.8.1.tgz npm/@img/colour-1.1.0.tgz npm/@img/sharp-libvips-linux-x64-1.3.4.tgz npm/@img/sharp-linux-x64-0.35.5.tgz npm/@jridgewell/resolve-uri-3.1.2.tgz npm/@jridgewell/sourcemap-codec-1.6.0.tgz npm/@jridgewell/trace-mapping-0.3.9.tgz npm/@poppinss/colors-4.1.6.tgz npm/@poppinss/dumper-0.6.5.tgz npm/@poppinss/exception-1.2.3.tgz npm/@sindresorhus/is-7.2.0.tgz npm/@speed-highlight/core-1.2.24.tgz npm/blake3-wasm-2.1.5.tgz npm/cf-1.0.0-beta.26.tgz npm/cookie-1.1.1.tgz npm/detect-libc-2.1.2.tgz npm/error-stack-parser-es-1.0.5.tgz npm/kleur-4.1.5.tgz npm/miniflare-5.20261023.3-beta.tgz npm/semver-7.8.5.tgz npm/sharp-0.35.5.tgz npm/supports-color-10.2.2.tgz npm/undici-7.30.1.tgz npm/workerd-1.20261023.1.tgz npm/ws-8.21.0.tgz npm/youch-4.1.0-beta.10.tgz npm/youch-core-0.3.3.tgz npm/zod-4.6.6.tgz'
VERSION=1.0.0-beta.26
JOBS=$(nproc)
LIVE=/oath/store/pkg/cf/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "cf",
    "purl": "pkg:npm/cf@1.0.0-beta.26",
    "version": "1.0.0-beta.26"
  }
]
OATH_EOF
# Every tarball in libexec/cf/node_modules as npm lays it out (no two
# packages need different versions of a third, so the tree is flat), and
# bin/cf and bin/cloudflare, the names npm would link, which run cf with
# pkg:node. npm never runs, and nor do install scripts: workerd's only
# checks that its platform package, which is here, is installed. workerd
# names /lib64/ld-linux-x86-64.so.2; Oath's loader is /lib's (R17), so
# patchelf points it there. components.json names every package, so
# advisories cover each one.
export HOME=/tmp/home
m=/out/libexec/cf/node_modules
mkdir -p "$HOME" "$m" /out/bin
for t in $(cd "$SRC" && find npm -name '*.tgz' | sort); do
	rm -rf /tmp/p && mkdir /tmp/p
	tar -xzf "$SRC/$t" --no-same-owner -C /tmp/p
	set -- /tmp/p/*
	[ $# = 1 ] && [ -f "$1/package.json" ]
	n=$(node -p 'require(process.argv[1]).name' "$1/package.json")
	[ ! -e "$m/$n" ]
	mkdir -p "$(dirname "$m/$n")"
	mv "$1" "$m/$n"
done
w=$m/@cloudflare/workerd-linux-64/bin/workerd
patchelf --set-interpreter /lib/ld-linux-x86-64.so.2 "$w"
node - "$m" >/out/components.json <<'EOT'
const fs = require("fs"), path = require("path");
const m = process.argv[2], out = [];
for (const d of fs.readdirSync(m).sort()) {
	const ds = d.startsWith("@") ? fs.readdirSync(path.join(m, d)).sort().map((s) => `${d}/${s}`) : [d];
	for (const n of ds) {
		const p = JSON.parse(fs.readFileSync(path.join(m, n, "package.json")));
		out.push({ name: p.name, version: p.version, purl: `pkg:npm/${p.name.replace(/^@/, "%40")}@${p.version}` });
	}
}
console.log(JSON.stringify(out, null, 2));
EOT
for b in cf cloudflare; do
	cat >/out/bin/$b <<EOT
#!/bin/sh
# cf $VERSION, Cloudflare's CLI, with the npm packages pkgs/cf pins; a
# newer one is a new set of pins there.
exec /oath/store/pkg/node/live/bin/node $LIVE/libexec/cf/node_modules/cf/bin/cf "\$@"
EOT
	chmod 755 /out/bin/$b
done

# It runs; miniflare loads (sharp and its libvips with it), and workerd
# starts.
grep -q '"name": "cf"' /out/components.json
node "$m/cf/bin/cf" --version | grep -qF "$VERSION"
node --input-type=module -e "await import('$m/miniflare/dist/src/index.js'); await import('$m/sharp/dist/index.mjs')"
"$w" --version | grep -q '^workerd '
