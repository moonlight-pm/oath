oto/googleapis/api/@v/v0.0.0-20260817212433-ac3dfec99bb1.zip gomod/google.golang.org/genproto/googleapis/rpc/@v/v0.0.0-20260817212433-ac3dfec99bb1.mod gomod/google.golang.org/genproto/googleapis/rpc/@v/v0.0.0-20260817212433-ac3dfec99bb1.zip gomod/google.golang.org/grpc/@v/v1.85.0.mod gomod/google.golang.org/grpc/@v/v1.85.0.zip gomod/google.golang.org/protobuf/@v/v1.36.12.mod gomod/google.golang.org/protobuf/@v/v1.36.12.zip gomod/gopkg.in/inf.v0/@v/v0.9.1.mod gomod/gopkg.in/inf.v0/@v/v0.9.1.zip gomod/gopkg.in/tomb.v1/@v/v1.0.0-20141024135613-dd632973f1e7.mod gomod/gopkg.in/tomb.v1/@v/v1.0.0-20141024135613-dd632973f1e7.zip gomod/gopkg.in/yaml.v3/@v/v3.0.1.mod gomod/gopkg.in/yaml.v3/@v/v3.0.1.zip gomod/sigs.k8s.io/yaml/@v/v1.6.0.mod gomod/sigs.k8s.io/yaml/@v/v1.6.0.zip gomod/tags.cncf.io/container-device-interface/@v/v1.1.0.mod gomod/tags.cncf.io/container-device-interface/@v/v1.1.0.zip gomod/tags.cncf.io/container-device-interface/specs-go/@v/v1.1.0.mod gomod/tags.cncf.io/container-device-interface/specs-go/@v/v1.1.0.zip'
VERSION=6.1.4
JOBS=$(nproc)
LIVE=/oath/store/pkg/podman/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "podman",
    "purl": "pkg:golang/github.com/containers/podman/v6@6.1.4",
    "version": "6.1.4"
  }
]
OATH_EOF
# Output: bin/podman, libexec/podman/{rootlessport,quadlet}, the defaults in
# share/containers, every licence the program carries in share/doc/podman,
# and components.json naming each linked module. A machine's own settings go
# in /etc/containers, which it reads over these.
export HOME=/tmp/home GOCACHE=/tmp/gocache GOPATH=/tmp/gopath GOMODCACHE=/tmp/gomod \
	CGO_ENABLED=1 GOSUMDB=off GOPROXY="file://$SRC/gomod" GOFLAGS='-mod=readonly -trimpath' \
	CGO_CFLAGS="$CFLAGS" CGO_LDFLAGS="$LDFLAGS"
mkdir -p "$HOME" /tmp/podman /out/bin /out/libexec/podman /out/share/containers /out/share/doc/podman
cd /tmp/podman
tar -xzf "$SRC/podman-$VERSION.tar.gz" --no-same-owner --strip-components=1
rm -rf vendor
cp "$FILES/go.mod" "$FILES/go.sum" .

tags='grpcnotrace seccomp libsqlite3 containers_image_openpgp exclude_graphdriver_btrfs'
p=github.com/containers/podman/v6
# libsqlite3.a needs libm, after it on the linker's line.
ld="-s -w -extldflags=-lm -X $p/libpod/config._installPrefix=$LIVE -X $p/libpod/config._etcDir=/etc
	-X $p/pkg/systemd/quadlet._binDir=$LIVE/bin
	-X go.podman.io/common/pkg/config.additionalHelperBinariesDir=$LIVE/libexec/podman
	-X go.podman.io/storage/pkg/configfile.systemConfigPath=$LIVE/share/containers"
go build -tags "$tags" -ldflags "$ld" -o /out/bin/podman ./cmd/podman
go build -tags "$tags" -ldflags "$ld" -o /out/libexec/podman/rootlessport ./cmd/rootlessport
go build -tags "$tags" -ldflags "$ld" -o /out/libexec/podman/quadlet ./cmd/quadlet

cp "$FILES/policy.json" "$FILES/containers.conf" /out/share/containers/
cp LICENSE /out/share/doc/podman/
(cd "$GOMODCACHE" && find . \( -path ./cache -o -name testdata \) -prune -o -type f \( -iname 'LICEN[CS]E*' -o -iname 'NOTICE*' \) \
	-exec cp --parents {} /out/share/doc/podman/ \;)
chmod -R u+w "$GOMODCACHE" /out/share/doc/podman
go-components podman "$VERSION" "pkg:golang/$p@$VERSION" \
	/out/bin/podman /out/libexec/podman/rootlessport /out/libexec/podman/quadlet >/out/components.json

/out/bin/podman --version | grep -q "version $VERSION"
