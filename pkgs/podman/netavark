#!/bin/sh
# Podman will not start without a netavark, even for pasta or the host's network,
# and Oath's rootless containers use pasta (R53). This stands in for it, and for
# the 257 crates and protobuf the real one builds with (R57). A bridge network says
# so here instead.
case "$1" in
--version | version)
	echo 'netavark 0.0.0 (Oath: no bridge networks)'
	exit 0
	;;
esac
echo 'netavark: Oath has no bridge networks; use --network pasta (R53)' >&2
exit 1
