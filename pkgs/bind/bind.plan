#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/bind/
SRC=/oath/store/pkg/bind-src/sha256-10ddf705be4f8a7bd57a1d26be6f25792ef049aaf0b78c348fa1d107e37f9763/src
FILES=/oath/store/pkg/bind-src/sha256-10ddf705be4f8a7bd57a1d26be6f25792ef049aaf0b78c348fa1d107e37f9763/files
SOURCES='bind-9.20.29.tar.xz'
VERSION=9.20.29
JOBS=$(nproc)
LIVE=/oath/store/pkg/bind/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "bind",
    "purl": "pkg:generic/bind@9.20.29",
    "version": "9.20.29"
  }
]
OATH_EOF
# dig, host and nslookup, and the BIND libraries they load. named and
# the other tools are not built; no DNS over HTTPS (nghttp2), IDN,
# readline, GeoIP or jemalloc.
tar -xf "$SRC/$SOURCES"
cd "bind-$VERSION"
./configure --prefix="$LIVE" --sysconfdir=/etc --localstatedir=/var --disable-static \
	--disable-doh --disable-geoip --disable-dnstap --without-jemalloc \
	--without-libxml2 --without-json-c --without-lmdb --without-libidn2 \
	--without-readline --without-zlib --without-gssapi --without-cmocka
make -j"$JOBS" -C lib
make -j"$JOBS" -C bin/dig
make -C lib install DESTDIR=/tmp/dest
make -C bin/dig install DESTDIR=/tmp/dest
mkdir -p /out/lib
cp -a "/tmp/dest$LIVE/bin" /out/
for l in isc dns ns isccfg; do
	cp -a "/tmp/dest$LIVE"/lib/lib$l-*.so /out/lib/
done
