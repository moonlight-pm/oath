#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/flex/
SRC=/oath/store/pkg/flex-src/sha256-7ca4272d96fcf4c3352a56e762e4dacf5cb46e83c37d665ebf3268b844d0db39/src
FILES=/oath/store/pkg/flex-src/sha256-7ca4272d96fcf4c3352a56e762e4dacf5cb46e83c37d665ebf3268b844d0db39/files
SOURCES='flex-2.6.4.tar.gz'
VERSION=2.6.4
JOBS=$(nproc)
LIVE=/oath/store/pkg/flex/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "flex",
    "purl": "pkg:github/westes/flex@v2.6.4",
    "version": "2.6.4"
  }
]
OATH_EOF
# The release ships its own scanner (src/scan.c), so flex is not needed
# to build flex. It runs m4 from PATH (the path configure found).
tar -xf "$SRC/$SOURCES"
cd flex-$VERSION
./configure --prefix=/ --disable-nls --disable-shared --disable-bootstrap
make -C src -j"$JOBS" flex
mkdir -p /out/bin
cp src/flex /out/bin/flex
ln -s flex /out/bin/lex
