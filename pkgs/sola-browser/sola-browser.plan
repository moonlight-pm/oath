#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/sola-browser/
SRC=/oath/store/pkg/sola-browser-src/sha256-1efdce155d580e313298c73ccfffc579e527611b35a33c2bcfdebb1223495d12/src
FILES=/oath/store/pkg/sola-browser-src/sha256-1efdce155d580e313298c73ccfffc579e527611b35a33c2bcfdebb1223495d12/files
SOURCES='sola'
VERSION=0.1.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/sola-browser/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "sola-browser",
    "purl": "pkg:generic/sola-browser@0.1.0",
    "version": "0.1.0"
  }
]
OATH_EOF
# sola-browser, built offline against pkg:sola-crates and pkg:cef. The
# build finds CEF in $HOME/.cache (cef-dll-sys) and $XDG_CACHE_HOME
# (Sola's), and bakes the latter into RUNPATH, so it names pkg:cef's
# slot. RUSTFLAGS replaces the tree's NixOS rpaths.
export CARGO_HOME=/tmp/cargo HOME=/tmp/home XDG_CACHE_HOME=/oath/store/pkg/cef/live
export RUSTFLAGS="-C link-arg=-Wl,--enable-new-dtags"
mkdir -p "$CARGO_HOME" "$HOME/.cache/sola"
cp /oath/store/pkg/sola-crates/live/vendor.toml "$CARGO_HOME/config.toml"
v=$(cat "$SRC/sola/cef-version")
ln -s /oath/store/pkg/cef/live/cef "$HOME/.cache/sola/cef-$v"
cp -R "$SRC/sola" /tmp/sola
cd /tmp/sola
cargo build --release --frozen -p sola-browser
mkdir -p /out/bin
cp target/release/sola-browser /out/bin/
ln -s /oath/store/pkg/cef/live/cef /out/cef
