#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/patchelf/
SRC=/oath/store/pkg/patchelf-src/sha256-12d0480c08d6c1971d0ee3e7b450476e79cddc39fb0fd54c587ec9abc2f1c465/src
FILES=/oath/store/pkg/patchelf-src/sha256-12d0480c08d6c1971d0ee3e7b450476e79cddc39fb0fd54c587ec9abc2f1c465/files
SOURCES='patchelf-0.19.2.tar.gz'
VERSION=0.19.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/patchelf/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "patchelf",
    "purl": "pkg:generic/patchelf@0.19.2",
    "version": "0.19.2"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd patchelf-$VERSION
./configure --prefix=/
make -j"$JOBS"
mkdir -p /out/bin
cp src/patchelf /out/bin/patchelf
