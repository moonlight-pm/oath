#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/dosfstools/
SRC=/oath/store/pkg/dosfstools-src/sha256-6e4eab2c9f865e8010c52a412b0e0c4d95a367e3e9bcc9fca5addc4afc7ace86/src
FILES=/oath/store/pkg/dosfstools-src/sha256-6e4eab2c9f865e8010c52a412b0e0c4d95a367e3e9bcc9fca5addc4afc7ace86/files
SOURCES='dosfstools-4.2.tar.gz'
VERSION=4.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/dosfstools/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "dosfstools",
    "purl": "pkg:generic/dosfstools@4.2",
    "version": "4.2"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd dosfstools-$VERSION
./configure --prefix=/ --without-udev
make -j"$JOBS"
mkdir -p /out/bin
cp src/mkfs.fat src/fsck.fat /out/bin/
ln -s mkfs.fat /out/bin/mkfs.vfat
