---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/make/
SRC=/oath/store/pkg/make-src/sha256-fc91d09b21811cf6cba902351968138ed9f5d8623ef4672e575d3bff727d658d/src
FILES=/oath/store/pkg/make-src/sha256-fc91d09b21811cf6cba902351968138ed9f5d8623ef4672e575d3bff727d658d/files
SOURCES='make-4.4.1.tar.gz'
VERSION=4.4.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/make/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "make",
    "purl": "pkg:generic/make@4.4.1",
    "version": "4.4.1"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd make-$VERSION
./configure --prefix=/ --disable-nls --without-guile CC=cc AR=ar RANLIB=ranlib
make -j"$JOBS"
mkdir -p /out/bin
cp make /out/bin/make
ln -s make /out/bin/gmake
