#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/restic/
SRC=/oath/store/pkg/restic-src/sha256-2cc815707cd76a2999b6c4337257a6316a9d4bf0c1c0c416b4227b42038a1280/src
FILES=/oath/store/pkg/restic-src/sha256-2cc815707cd76a2999b6c4337257a6316a9d4bf0c1c0c416b4227b42038a1280/files
SOURCES='restic-0.19.1.tar.gz gomod/github.com/anacrolix/fuse/@v/v0.3.1.mod gomod/github.com/anacrolix/fuse/@v/v0.3.1.zip gomod/github.com/cenkalti/backoff/v4/@v/v4.3.0.mod gomod/github.com/cenkalti/backoff/v4/@v/v4.3.0.zip gomod/github.com/cespare/xxhash/v2/@v/v2.3.0.mod gomod/github.com/cespare/xxhash/v2/@v/v2.3.0.zip gomod/github.com/cpuguy83/go-md2man/v2/@v/v2.0.6.mod gomod/github.com/cpuguy83/go-md2man/v2/@v/v2.0.6.zip gomod/github.com/dustin/go-humanize/@v/v1.0.1.mod gomod/github.com/dustin/go-humanize/@v/v1.0.1.zip gomod/github.com/elithrar/simple-scrypt/@v/v1.4.1.mod gomod/github.com/elithrar/simple-scrypt/@v/v1.4.1.zip gomod/github.com/go-ini/ini/@v/v1.67.0.mod gomod/github.com/go-ini/ini/@v/v1.67.0.zip gomod/github.com/google/uuid/@v/v1.6.0.mod gomod/github.com/google/uuid/@v/v1.6.0.zip gomod/github.com/hashicorp/golang-lru/v2/@v/v2.0.7.mod gomod/github.com/hashicorp/golang-lru/v2/@v/v2.0.7.zip gomod/github.com/klauspost/compress/@v/v1.20.2.mod gomod/github.com/klauspost/compress/@v/v1.20.2.zip gomod/github.com/klauspost/cpuid/v2/@v/v2.2.11.mod gomod/github.com/klauspost/cpuid/v2/@v/v2.2.11.zip gomod/github.com/klauspost/crc32/@v/v1.3.0.mod gomod/github.com/klauspost/crc32/@v/v1.3.0.zip gomod/github.com/kr/fs/@v/v0.1.0.mod gomod/github.com/kr/fs/@v/v0.1.0.zip gomod/github.com/minio/crc64nvme/@v/v1.1.1.mod gomod/github.com/minio/crc64nvme/@v/v1.1.1.zip gomod/github.com/minio/md5-simd/@v/v1.1.2.mod gomod/github.com/minio/md5-simd/@v/v1.1.2.zip gomod/github.com/minio/minio-go/v7/@v/v7.1.0.mod gomod/github.com/minio/minio-go/v7/@v/v7.1.0.zip gomod/github.com/peterbourgon/unixtransport/@v/v0.0.7.mod gomod/github.com/peterbourgon/unixtransport/@v/v0.0.7.zip gomod/github.com/philhofer/fwd/@v/v1.2.0.mod gomod/github.com/philhofer/fwd/@v/v1.2.0.zip gomod/github.com/pkg/errors/@v/v0.9.1.mod gomod/github.com/pkg/errors/@v/v0.9.1.zip gomod/github.com/pkg/sftp/@v/v1.13.10.mod gomod/github.com/pkg/sftp/@v/v1.13.10.zip gomod/github.com/pkg/xattr/@v/v0.4.12.mod gomod/github.com/pkg/xattr/@v/v0.4.12.zip gomod/github.com/restic/chunker/@v/v0.4.0.mod gomod/github.com/restic/chunker/@v/v0.4.0.zip gomod/github.com/rs/xid/@v/v1.6.0.mod gomod/github.com/rs/xid/@v/v1.6.0.zip gomod/github.com/russross/blackfriday/v2/@v/v2.1.0.mod gomod/github.com/russross/blackfriday/v2/@v/v2.1.0.zip gomod/github.com/spf13/cobra/@v/v1.10.2.mod gomod/github.com/spf13/cobra/@v/v1.10.2.zip gomod/github.com/spf13/pflag/@v/v1.0.10.mod gomod/github.com/spf13/pflag/@v/v1.0.10.zip gomod/github.com/tinylib/msgp/@v/v1.6.1.mod gomod/github.com/tinylib/msgp/@v/v1.6.1.zip gomod/github.com/zeebo/xxh3/@v/v1.1.0.mod gomod/github.com/zeebo/xxh3/@v/v1.1.0.zip gomod/go.uber.org/automaxprocs/@v/v1.6.0.mod gomod/go.uber.org/automaxprocs/@v/v1.6.0.zip gomod/go.yaml.in/yaml/v3/@v/v3.0.4.mod gomod/go.yaml.in/yaml/v3/@v/v3.0.4.zip gomod/golang.org/x/crypto/@v/v0.58.0.mod gomod/golang.org/x/crypto/@v/v0.58.0.zip gomod/golang.org/x/net/@v/v0.62.0.mod gomod/golang.org/x/net/@v/v0.62.0.zip gomod/golang.org/x/sync/@v/v0.24.0.mod gomod/golang.org/x/sync/@v/v0.24.0.zip gomod/golang.org/x/sys/@v/v0.49.0.mod gomod/golang.org/x/sys/@v/v0.49.0.zip gomod/golang.org/x/term/@v/v0.47.0.mod gomod/golang.org/x/term/@v/v0.47.0.zip gomod/golang.org/x/text/@v/v0.43.0.mod gomod/golang.org/x/text/@v/v0.43.0.zip gomod/golang.org/x/time/@v/v0.15.0.mod gomod/golang.org/x/time/@v/v0.15.0.zip'
VERSION=0.19.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/restic/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "restic",
    "purl": "pkg:golang/github.com/restic/restic@0.19.1",
    "version": "0.19.1"
  }
]
OATH_EOF
# Output: bin/restic, static, with every licence the program carries in
# share/doc/restic, and components.json naming each linked module.
export HOME=/tmp/home GOCACHE=/tmp/gocache GOPATH=/tmp/gopath GOMODCACHE=/tmp/gomod \
	CGO_ENABLED=0 GOSUMDB=off GOPROXY="file://$SRC/gomod" GOFLAGS='-mod=readonly -trimpath'
mkdir -p "$HOME" /tmp/restic /out/bin /out/share/doc/restic
cd /tmp/restic
tar -xzf "$SRC/restic-$VERSION.tar.gz" --no-same-owner --strip-components=1
for p in "$FILES"/patches/*.patch; do
	patch -p1 -i "$p"
done
cp "$FILES/go.mod" "$FILES/go.sum" .
go build -ldflags "-s -w -X main.version=$VERSION" -o /out/bin/restic ./cmd/restic
cp LICENSE /out/share/doc/restic/
(cd "$GOMODCACHE" && find . \( -path ./cache -o -name testdata \) -prune -o -type f \( -iname 'LICEN[CS]E*' -o -iname 'NOTICE*' \) \
	-exec cp --parents {} /out/share/doc/restic/ \;)
chmod -R u+w "$GOMODCACHE" /out/share/doc/restic
go-components restic "$VERSION" "pkg:golang/github.com/restic/restic@$VERSION" \
	/out/bin/restic >/out/components.json

/out/bin/restic version | grep -q "^restic $VERSION "
export RESTIC_PASSWORD=x RESTIC_REPOSITORY=/tmp/repo RESTIC_CACHE_DIR=/tmp/rcache
/out/bin/restic init
echo data >/tmp/data
/out/bin/restic backup /tmp/data
/out/bin/restic restore latest --target /tmp/restored
cmp /tmp/data /tmp/restored/tmp/data
