#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/sola/
SRC=/oath/store/pkg/sola-src/sha256-16fff89e26d3418620e92a7489c4e1ab581c4b61d764135de66080d6a643a8ff/src
FILES=/oath/store/pkg/sola-src/sha256-16fff89e26d3418620e92a7489c4e1ab581c4b61d764135de66080d6a643a8ff/files
SOURCES='lucide-423afc6d03c1fb1b86090aa14b13f7f2fa6296e4.tar.gz simple-icons-48b3f924fdfd227a75abc0563f667825f8a6e714.tar.gz McMojave-cursors-7d0bfc1f91028191cdc220b87fd335a235ee4439.tar.gz sola'
VERSION=0.1.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/sola/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "sola",
    "purl": "pkg:generic/sola@0.1.0",
    "version": "0.1.0"
  }
]
OATH_EOF
# The Sola binaries, built offline against pkg:sola-crates, and share/.
export CARGO_HOME=/tmp/cargo HOME=/tmp/home
mkdir -p "$CARGO_HOME" "$HOME"
cp /oath/store/pkg/sola-crates/live/vendor.toml "$CARGO_HOME/config.toml"
cp -R "$SRC/sola" /tmp/sola
cd /tmp/sola
bins="sola-bus sola-call sola-river sola-shell sola-session sola-terminal solactl sola-oath"
cargo build --release --frozen $(for b in $bins; do printf -- '-p %s ' "$b"; done)
mkdir -p /out/bin
for b in $bins; do
	cp "target/release/$b" /out/bin/
done
share=/out/share
mkdir -p "$share/icons" "$share/cursors"
cp -R crates/sola-assets/icons/sola "$share/icons/sola"
for a in "$SRC"/lucide-*.tar.gz "$SRC"/simple-icons-*.tar.gz "$SRC"/McMojave-*.tar.gz; do
	tar -xzf "$a" -C /tmp
done
mkdir -p "$share/icons/lucide" "$share/icons/simpleicons" "$share/cursors/McMojave"
cp /tmp/lucide-*/icons/*.svg "$share/icons/lucide/"
cp /tmp/simple-icons-*/icons/*.svg "$share/icons/simpleicons/"
cp -R /tmp/McMojave-cursors-*/dist/. "$share/cursors/McMojave/"
