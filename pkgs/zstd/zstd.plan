#!oath-plan
{
  "name": "zstd",
  "produces": "pkg:zstd",
  "build_needs": [
    {
      "id": "pkg:busybox",
      "hash": "sha256-5c07428c094578850fa4fbf5ab3eb123d4d563178885cb4b32fae5deaa951d35"
    },
    {
      "id": "pkg:llvm",
      "hash": "sha256-1a5d6cad24b01b2dcef476d260fb3a108471708948d661767e249d2653ed65ea"
    },
    {
      "id": "pkg:make",
      "hash": "sha256-ade99e47287653412c2bfabcf7495c787598975dbe6155109cba2c81ae1431cf"
    },
    {
      "id": "pkg:zstd-src",
      "hash": "sha256-74a50651b5e89baf55e04002c9b44bbdc37e5fe8b17dec90d53205ddb394d964"
    }
  ],
  "run_needs": []
}
---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/zstd/
SRC=/oath/store/pkg/zstd-src/sha256-74a50651b5e89baf55e04002c9b44bbdc37e5fe8b17dec90d53205ddb394d964/src
FILES=/oath/store/pkg/zstd-src/sha256-74a50651b5e89baf55e04002c9b44bbdc37e5fe8b17dec90d53205ddb394d964/files
SOURCES='zstd-1.5.7.tar.gz'
VERSION=1.5.7
JOBS=$(nproc)
LIVE=/oath/store/pkg/zstd/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "zstd",
    "purl": "pkg:generic/zstd@1.5.7",
    "version": "1.5.7"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd zstd-$VERSION/lib
make -j"$JOBS" libzstd.a
mkdir -p /out/include /out/lib/pkgconfig
cp zstd.h zdict.h zstd_errors.h /out/include/
cp libzstd.a /out/lib/
cat > /out/lib/pkgconfig/libzstd.pc <<PC
prefix=$LIVE
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: zstd
Description: fast lossless compression algorithm library
Version: $VERSION
Libs: -L\${libdir} -lzstd
Cflags: -I\${includedir}
PC
