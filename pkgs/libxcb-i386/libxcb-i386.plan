#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/libxcb-i386/
SRC=/oath/store/pkg/libxcb-i386-src/sha256-f08390ee7bf4b6b09012098e143433df25caa05de7473a5f577c93dcc48e7f75/src
FILES=/oath/store/pkg/libxcb-i386-src/sha256-f08390ee7bf4b6b09012098e143433df25caa05de7473a5f577c93dcc48e7f75/files
SOURCES='libxcb-1.17.0.tar.xz'
VERSION=1.17.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/libxcb-i386/live
LIBDIR=lib32
export CC="cc -m32" CXX="c++ -m32" AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH= pc=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | */glibc-i386/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib32" ] && LDFLAGS="$LDFLAGS -L$d/lib32"
	[ -d "$d/lib32/pkgconfig" ] && PKG_CONFIG_PATH="${PKG_CONFIG_PATH:+$PKG_CONFIG_PATH:}$d/lib32/pkgconfig"
	[ -d "$d/lib/pkgconfig" ] && pc="${pc:+$pc:}$d/lib/pkgconfig"
done
PKG_CONFIG_PATH="$PKG_CONFIG_PATH${pc:+:$pc}"
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "libxcb-i386",
    "purl": "pkg:generic/libxcb@1.17.0",
    "version": "1.17.0"
  }
]
OATH_EOF
# libxcb and its extension libraries, shared, generated from xcb-proto.
tar -xf "$SRC/$SOURCES"
cd "libxcb-$VERSION"
./configure --prefix="$LIVE" --libdir="$LIVE/$LIBDIR" --disable-static --disable-devel-docs --without-doxygen
make -j"$JOBS"
make install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/$LIBDIR" /out/
rm -f "/out/$LIBDIR"/*.la
