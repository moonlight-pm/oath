#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/elfutils/
SRC=/oath/store/pkg/elfutils-src/sha256-d7c6ca17eefd772c3a0ea575b9e5cb399e25394e5ed8f5b6475a1f662703cab6/src
FILES=/oath/store/pkg/elfutils-src/sha256-d7c6ca17eefd772c3a0ea575b9e5cb399e25394e5ed8f5b6475a1f662703cab6/files
SOURCES='elfutils-0.196.tar.bz2'
VERSION=0.196
JOBS=$(nproc)
LIVE=/oath/store/pkg/elfutils/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "elfutils",
    "purl": "pkg:generic/elfutils@0.196",
    "version": "0.196"
  }
]
OATH_EOF
# configure insists on argp, fts and obstack for the tools and libdw;
# libelf uses none of them, so tell it they are there and build only
# libelf/, with the libeu helpers it folds in. Left out: color.c and
# printversion.c (for the tools; they include argp.h) and crc32.c and
# crc32_file.c (libelf has its own; a public crc32 clashes with zlib's
# in a static link).
tar -xf "$SRC/$SOURCES"
cd elfutils-$VERSION
./configure --prefix="$LIVE" --disable-nls --disable-debuginfod \
	--disable-libdebuginfod --disable-demangler --disable-symbol-versioning \
	--without-bzlib --without-lzma --without-zstd \
	ac_cv_search_argp_parse='none required' \
	ac_cv_search_fts_close='none required' \
	ac_cv_search__obstack_free='none required'
eu="xasprintf.o xstrdup.o xstrndup.o xmalloc.o next_prime.o eu-search.o error.o"
# shellcheck disable=SC2086
make -C lib -j"$JOBS" $eu
echo "$eu" >lib/libeu.manifest
make -C libelf -j"$JOBS" libelf.a
mkdir -p /out/include /out/lib/pkgconfig
cp libelf/libelf.h libelf/gelf.h libelf/nlist.h /out/include/
cp libelf/libelf.a /out/lib/
cp config/libelf.pc /out/lib/pkgconfig/
