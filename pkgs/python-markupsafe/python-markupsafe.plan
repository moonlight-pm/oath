#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/python-markupsafe/
SRC=/oath/store/pkg/python-markupsafe-src/sha256-7ba2519d2e838b0fe079ea0b43a1fd0bb9327ae83d8d578db32081fb143a629e/src
FILES=/oath/store/pkg/python-markupsafe-src/sha256-7ba2519d2e838b0fe079ea0b43a1fd0bb9327ae83d8d578db32081fb143a629e/files
SOURCES='markupsafe-3.0.4.tar.gz'
VERSION=3.0.4
JOBS=$(nproc)
LIVE=/oath/store/pkg/python-markupsafe/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "python-markupsafe",
    "purl": "pkg:pypi/markupsafe@3.0.4",
    "version": "3.0.4"
  }
]
OATH_EOF
# Pure Python, for a build's PYTHONPATH: $LIVE/lib/python. Without its C
# speedups it uses _native.
tar -xf "$SRC/$SOURCES"
mkdir -p /out/lib/python
cp -a "markupsafe-$VERSION/src/markupsafe" /out/lib/python/
rm -f /out/lib/python/markupsafe/_speedups.c /out/lib/python/markupsafe/_speedups.pyi
