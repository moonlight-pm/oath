#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/mesa-i386/
SRC=/oath/store/pkg/mesa-i386-src/sha256-e46d8e6636e11536ef62baac42625d044c59c41412fd7b2309f5d1f63245967a/src
FILES=/oath/store/pkg/mesa-i386-src/sha256-e46d8e6636e11536ef62baac42625d044c59c41412fd7b2309f5d1f63245967a/files
SOURCES='mesa-26.2.5.tar.xz'
VERSION=26.2.5
JOBS=$(nproc)
LIVE=/oath/store/pkg/mesa-i386/live
LIBDIR=lib32
export CC="cc -m32" CXX="c++ -m32" AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH= pc=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | */glibc-i386/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib32" ] && LDFLAGS="$LDFLAGS -L$d/lib32"
	[ -d "$d/lib32/pkgconfig" ] && PKG_CONFIG_PATH="${PKG_CONFIG_PATH:+$PKG_CONFIG_PATH:}$d/lib32/pkgconfig"
	[ -d "$d/lib/pkgconfig" ] && pc="${pc:+$pc:}$d/lib/pkgconfig"
done
PKG_CONFIG_PATH="$PKG_CONFIG_PATH${pc:+:$pc}"
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "mesa-i386",
    "purl": "pkg:generic/mesa@26.2.5",
    "version": "26.2.5"
  }
]
OATH_EOF
# Mesa: libEGL, libGLESv2, libGL (GLX), libgbm and the radeonsi and
# softpipe drivers, on Wayland and X11. drirc's per-program workarounds
# are on (xmlconfig, expat). RADV, the Vulkan driver for amdgpu, and the
# device-select layer, which puts the compositor's GPU first: their
# manifests (share/vulkan) name each library by its name, found in /lib.
tar -xf "$SRC/$SOURCES"
cd "mesa-$VERSION"
PYTHONPATH=
for m in mako markupsafe pyyaml packaging; do
	PYTHONPATH="$PYTHONPATH${PYTHONPATH:+:}/oath/store/pkg/python-$m/live/lib/python"
done
export PYTHONPATH
meson setup build --prefix="$LIVE" --libdir="$LIBDIR" --buildtype=release --wrap-mode=nofallback \
	-Dplatforms=wayland,x11 -Dgallium-drivers=radeonsi,softpipe \
	-Dvulkan-drivers=amd -Dvulkan-layers=device-select -Dvulkan-manifest-per-architecture=false \
	-Dllvm=disabled -Damd-use-llvm=false -Ddraw-use-llvm=false \
	-Degl=enabled -Dgbm=enabled -Dgles2=enabled -Dgles1=disabled -Dopengl=true \
	-Dglx=dri -Dglvnd=disabled -Dxlib-lease=disabled \
	-Dgallium-va=disabled -Dgallium-rusticl=false -Dgallium-d3d10umd=false \
	-Dgallium-mediafoundation=disabled -Dgallium-d3d12-video=disabled -Dmicrosoft-clc=disabled \
	-Dvideo-codecs= -Dtools= -Dbuild-tests=false -Denable-glcpp-tests=false \
	-Dvalgrind=disabled -Dlibunwind=disabled -Dlmsensors=disabled -Dperfetto=false \
	-Dexpat=enabled -Dxmlconfig=enabled -Dzlib=enabled -Dzstd=enabled \
	-Ddisplay-info=disabled -Dspirv-tools=disabled -Dshader-cache=enabled -Dhtml-docs=disabled
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/$LIBDIR" "/tmp/dest$LIVE/share" /out/
grep -q '"library_path": "libvulkan_radeon.so"' /out/share/vulkan/icd.d/radeon_icd.json
