#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/libxdamage/
SRC=/oath/store/pkg/libxdamage-src/sha256-4c1414e3cfaf5619f90167955b3dfaf0966f5edbafd87aeacf86da0f6bda23fa/src
FILES=/oath/store/pkg/libxdamage-src/sha256-4c1414e3cfaf5619f90167955b3dfaf0966f5edbafd87aeacf86da0f6bda23fa/files
SOURCES='libXdamage-1.1.7.tar.xz'
VERSION=1.1.7
JOBS=$(nproc)
LIVE=/oath/store/pkg/libxdamage/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "libxdamage",
    "purl": "pkg:generic/libXdamage@1.1.7",
    "version": "1.1.7"
  }
]
OATH_EOF
# libXdamage, shared, with headers and pkg-config.
tar -xf "$SRC/$SOURCES"
cd "libXdamage-$VERSION"
./configure --prefix="$LIVE" --disable-static
make -j"$JOBS"
make install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
rm -f /out/lib/*.la
