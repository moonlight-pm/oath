#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/rust/
SRC=/oath/store/pkg/rust-src/sha256-7f06d841a0df3af6ec8b4ed2db9eaa11701c19ebe7a47be84635e6b3fdf0a635/src
FILES=/oath/store/pkg/rust-src/sha256-7f06d841a0df3af6ec8b4ed2db9eaa11701c19ebe7a47be84635e6b3fdf0a635/files
SOURCES='rustc-1.99.1-x86_64-unknown-linux-gnu.tar.xz cargo-1.99.1-x86_64-unknown-linux-gnu.tar.xz rust-std-1.99.1-x86_64-unknown-linux-gnu.tar.xz rust-std-1.99.1-x86_64-unknown-uefi.tar.xz'
VERSION=1.99.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/rust/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "rust",
    "purl": "pkg:generic/rust@1.99.1",
    "version": "1.99.1"
  }
]
OATH_EOF
# Output: bin/{rustc,rustdoc,cargo}, lib/ (librustc_driver, rustlib/) and
# share/doc/rust/. The vendor's binaries name /lib64/ld-linux-x86-64.so.2;
# Oath has no /lib64 (R17), so patchelf points them at /lib's loader.
host=x86_64-unknown-linux-gnu
for c in rustc-$VERSION-$host/rustc cargo-$VERSION-$host/cargo \
	rust-std-$VERSION-$host/rust-std-$host \
	rust-std-$VERSION-x86_64-unknown-uefi/rust-std-x86_64-unknown-uefi; do
	tar -xf "$SRC/${c%/*}.tar.xz"
	(cd "$c" && rm -f manifest.in && cp -R . /out/)
done
cd /out
rm -rf bin/rust-gdb bin/rust-gdbgui bin/rust-lldb etc libexec lib/rustlib/etc share/man
for f in bin/* lib/rustlib/$host/bin/* lib/rustlib/$host/bin/gcc-ld/*; do
	[ -f "$f" ] && patchelf --print-interpreter "$f" >/dev/null 2>&1 || continue
	patchelf --set-interpreter /lib/ld-linux-x86-64.so.2 "$f"
done

# It runs, and rustc can still unwind (it reports errors by panicking).
bin/rustc -vV
bin/cargo -V
echo 'fn main() { x }' >/tmp/bad.rs
bin/rustc --sysroot /out /tmp/bad.rs -o /tmp/bad 2>/tmp/bad.err && exit 1
grep -q 'error\[E0425\]' /tmp/bad.err
if grep -q 'fatal runtime error' /tmp/bad.err; then exit 1; fi
