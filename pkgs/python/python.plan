---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/python/
SRC=/oath/store/pkg/python-src/sha256-0e81a0b6b39b56a56d626567588fce80ea03a272562e6dedc3f9ef928da180c4/src
FILES=/oath/store/pkg/python-src/sha256-0e81a0b6b39b56a56d626567588fce80ea03a272562e6dedc3f9ef928da180c4/files
SOURCES='Python-3.15.0.tar.xz'
VERSION=3.15.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/python/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "python",
    "purl": "pkg:generic/cpython@3.15.0",
    "version": "3.15.0"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd Python-$VERSION
# One static binary: a static musl program cannot dlopen, so every
# stdlib extension is linked in (MODULE_BUILDTYPE=static).
MODULE_BUILDTYPE=static ./configure --prefix=/ --disable-shared \
	--without-ensurepip --disable-test-modules
make -j"$JOBS"
make install DESTDIR=/out
# The interpreter is the product: nothing can embed or extend a static
# python, so libpython (installed twice) goes, and so do IDLE and
# tkinter (_tkinter is not built).
rm -rf /out/share /out/lib/libpython*.a /out/lib/python3*/config-*/libpython*.a \
	/out/lib/python3*/idlelib /out/lib/python3*/tkinter \
	/out/lib/python3*/turtledemo /out/bin/idle3*
