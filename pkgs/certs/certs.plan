#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/certs/
SRC=/oath/store/pkg/certs-src/sha256-436feedf1bf2df899d22f05ed7d45a16afa23a84ab086d0cab04f58cc8aa6f92/src
FILES=/oath/store/pkg/certs-src/sha256-436feedf1bf2df899d22f05ed7d45a16afa23a84ab086d0cab04f58cc8aa6f92/files
SOURCES='cacert-2026-10-20.pem'
VERSION=2026-10-20
JOBS=$(nproc)
LIVE=/oath/store/pkg/certs/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "certs",
    "purl": "pkg:generic/certs@2026-10-20",
    "version": "2026-10-20"
  }
]
OATH_EOF
# Output: ssl/cert.pem, Mozilla's list as curl.se publishes it, without the
# roots distrust.txt names. The fingerprint is taken from each certificate,
# not from the comment beside it.
mkdir -p /out/ssl /tmp/c
awk -v RS= '{ print > sprintf("/tmp/c/%04d", NR) }' "$SRC/cacert-$VERSION.pem"
grep -v '^#' "$FILES/distrust.txt" | cut -d' ' -f1 >/tmp/distrust
if grep -qvE '^[0-9a-f]{64}$' /tmp/distrust; then
	echo "distrust.txt: not a fingerprint" >&2
	exit 1
fi
: >/tmp/seen
kept=0
for f in /tmp/c/*; do
	if grep -q -e '-----BEGIN CERTIFICATE-----' "$f"; then
		fp=$(sed -e '1,/-----BEGIN/d' -e '/-----END/,$d' "$f" | base64 -d | sha256sum | cut -d' ' -f1)
		[ ${#fp} = 64 ]
		if grep -qx "$fp" /tmp/distrust; then
			echo "$fp" >>/tmp/seen
			echo "== distrusted: $(head -n 1 "$f")" >&2
			continue
		fi
		kept=$((kept + 1))
	fi
	cat "$f"
	echo
done >/tmp/cert.pem
{
	echo "## Oath's CA roots (pkg:certs $VERSION): $kept of Mozilla's, less pkgs/certs/distrust.txt."
	echo
	cat /tmp/cert.pem
} >/out/ssl/cert.pem
while read -r fp; do
	grep -qx "$fp" /tmp/seen || echo "== already gone from upstream: $fp"
done </tmp/distrust

# A list this short is a broken parse.
[ "$kept" -gt 90 ]
[ "$(grep -c -e '-----BEGIN CERTIFICATE-----' /out/ssl/cert.pem)" = "$kept" ]
echo "== $kept roots"
