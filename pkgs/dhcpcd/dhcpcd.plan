#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/dhcpcd/
SRC=/oath/store/pkg/dhcpcd-src/sha256-0532cea67f51dbb4dda01f17cb49e15119e9aeed98b9b6945a345552b235c2b7/src
FILES=/oath/store/pkg/dhcpcd-src/sha256-0532cea67f51dbb4dda01f17cb49e15119e9aeed98b9b6945a345552b235c2b7/files
SOURCES='dhcpcd-10.5.2.tar.xz'
VERSION=10.5.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/dhcpcd/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "dhcpcd",
    "purl": "pkg:github/NetworkConfiguration/dhcpcd@v10.5.2",
    "version": "10.5.2"
  }
]
OATH_EOF
# dhcpcd, the DHCP client of net:net0 (R18). Oath runs it with its own
# hook (-c /lib/oath/dhcpcd.hook), so the stock hooks are not shipped.
# Privilege separation (R36): the processes that read the network run as
# void, chrooted in its empty home. Its seccomp filter is off: a syscall
# its list lacks (a newer glibc or kernel) kills them, and a headless
# machine then loses its network.
tar -xf "$SRC/$SOURCES"
cd "dhcpcd-$VERSION"
./configure --prefix="$LIVE" --sbindir="$LIVE/bin" --libexecdir="$LIVE/libexec" \
	--sysconfdir=/etc --dbdir=/var/lib/dhcpcd --rundir=/run/dhcpcd \
	--enable-privsep --privsepuser=void --disable-seccomp --without-udev
make -j"$JOBS"
make install DESTDIR=/tmp/dest
mkdir -p /out/bin
cp "/tmp/dest$LIVE/bin/dhcpcd" /out/bin/
