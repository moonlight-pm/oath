#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/qtnetworkauth/
SRC=/oath/store/pkg/qtnetworkauth-src/sha256-106352937a14200c3c15faca4bf0fb78504e40251edbf73acfed846cc5bd9e1e/src
FILES=/oath/store/pkg/qtnetworkauth-src/sha256-106352937a14200c3c15faca4bf0fb78504e40251edbf73acfed846cc5bd9e1e/files
SOURCES='qtnetworkauth-everywhere-src-6.11.3.tar.xz'
VERSION=6.11.3
JOBS=$(nproc)
LIVE=/oath/store/pkg/qtnetworkauth/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "qtnetworkauth",
    "purl": "pkg:generic/qtnetworkauth@6.11.3",
    "version": "6.11.3"
  }
]
OATH_EOF
# Shared, with headers and CMake packages, into this pack (its plugins in
# plugins/), built against pkg:qtbase.
tar -xf "$SRC/$SOURCES"
cd "qtnetworkauth-everywhere-src-$VERSION"
prefixes=$(printf %s "$PKG_CONFIG_PATH" | tr : '\n' | sed 's|/lib/pkgconfig$||' | paste -sd ';')
cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$LIVE" \
	-DCMAKE_PREFIX_PATH="/oath/store/pkg/qtbase/live;$prefixes" \
	-DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF
cmake --build build -j"$JOBS"
DESTDIR=/tmp/dest cmake --install build
cp -a "/tmp/dest$LIVE/." /out/
