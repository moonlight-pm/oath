+			}
+			u, err := url.Parse("https://app.example.com/%61dmin")
+			require.NoError(t, err)
+			_, ruleNum := ing.FindMatchingRule(u.Host, u)
+			assert.Equal(t, 1, ruleNum, "matching must still decode paths when normalization is disabled")
+		})
+	}
+}
