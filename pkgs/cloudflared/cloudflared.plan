text/@v/v0.43.0.zip gomod/google.golang.org/genproto/googleapis/api/@v/v0.0.0-20260720211330-0afa2a65878a.mod gomod/google.golang.org/genproto/googleapis/api/@v/v0.0.0-20260720211330-0afa2a65878a.zip gomod/google.golang.org/genproto/googleapis/rpc/@v/v0.0.0-20260720211330-0afa2a65878a.mod gomod/google.golang.org/genproto/googleapis/rpc/@v/v0.0.0-20260720211330-0afa2a65878a.zip gomod/google.golang.org/grpc/@v/v1.83.2.mod gomod/google.golang.org/grpc/@v/v1.83.2.zip gomod/google.golang.org/protobuf/@v/v1.36.11.mod gomod/google.golang.org/protobuf/@v/v1.36.11.zip gomod/gopkg.in/natefinch/lumberjack.v2/@v/v2.0.0.mod gomod/gopkg.in/natefinch/lumberjack.v2/@v/v2.0.0.zip gomod/gopkg.in/yaml.v2/@v/v2.4.0.mod gomod/gopkg.in/yaml.v2/@v/v2.4.0.zip gomod/gopkg.in/yaml.v3/@v/v3.0.1.mod gomod/gopkg.in/yaml.v3/@v/v3.0.1.zip gomod/nhooyr.io/websocket/@v/v1.8.7.mod gomod/nhooyr.io/websocket/@v/v1.8.7.zip gomod/zombiezen.com/go/capnproto2/@v/v2.18.0+incompatible.mod gomod/zombiezen.com/go/capnproto2/@v/v2.18.0+incompatible.zip'
VERSION=2026.10.5
JOBS=$(nproc)
LIVE=/oath/store/pkg/cloudflared/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "cloudflared",
    "purl": "pkg:golang/github.com/cloudflare/cloudflared@2026.10.5",
    "version": "2026.10.5"
  }
]
OATH_EOF
# Output: bin/cloudflared, static, with every licence the program carries in
# share/doc/cloudflared, and components.json naming each linked module.
# BuiltForPackageManager is upstream's switch for a packaged build: no
# self-update, and `cloudflared update` says to use the package manager. A newer
# cloudflared is a new pin in pkgs/cloudflared. patches/: upstream's fix of
# VULN-170057 (an Access bypass through matrix parameters), in 2026.11.0, which is
# under a week old; the last check below is that fix.
export HOME=/tmp/home GOCACHE=/tmp/gocache GOPATH=/tmp/gopath GOMODCACHE=/tmp/gomod \
	CGO_ENABLED=0 GOSUMDB=off GOPROXY="file://$SRC/gomod" GOFLAGS='-mod=readonly -trimpath'
mkdir -p "$HOME" /tmp/cloudflared /out/bin /out/share/doc/cloudflared
cd /tmp/cloudflared
tar -xzf "$SRC/cloudflared-$VERSION.tar.gz" --no-same-owner --strip-components=1
for p in "$FILES"/patches/*.patch; do
	[ -f "$p" ] || continue
	patch -p1 -i "$p"
done
[ ! -f "$FILES/go.mod" ] || cp "$FILES/go.mod" "$FILES/go.sum" .
go build -ldflags "-s -w -X main.Version=$VERSION \
	-X github.com/cloudflare/cloudflared/cmd/cloudflared/updater.BuiltForPackageManager=oath" \
	-o /out/bin/cloudflared ./cmd/cloudflared
cp LICENSE /out/share/doc/cloudflared/
(cd "$GOMODCACHE" && find . \( -path ./cache -o -name testdata \) -prune -o -type f \( -iname 'LICEN[CS]E*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) \
	-exec cp --parents {} /out/share/doc/cloudflared/ \;)
chmod -R u+w "$GOMODCACHE" /out/share/doc/cloudflared
go-components cloudflared "$VERSION" "pkg:golang/github.com/cloudflare/cloudflared@$VERSION" \
	/out/bin/cloudflared >/out/components.json

/out/bin/cloudflared --version | grep -q "version $VERSION "
/out/bin/cloudflared update 2>&1 | grep -q 'installed by oath'
cat >/tmp/cloudflared.yml <<'EOT'
ingress:
  - hostname: example.com
    service: http://127.0.0.1:8080
  - service: http_status:404
EOT
/out/bin/cloudflared tunnel --config /tmp/cloudflared.yml ingress validate
cat >/tmp/cloudflared-access.yml <<'EOT'
ingress:
  - hostname: example.com
    path: ^/admin
    service: http://127.0.0.1:8081
    originRequest:
      access:
        required: true
        teamName: example
        audTag: [example]
  - hostname: example.com
    service: http://127.0.0.1:8080
  - service: http_status:404
EOT
/out/bin/cloudflared tunnel --config /tmp/cloudflared-access.yml ingress rule \
	'https://example.com/public/.;x/../admin' | grep -q 'Matched rule #0'
