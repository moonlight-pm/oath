#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/libepoxy/
SRC=/oath/store/pkg/libepoxy-src/sha256-bf35712da9ea19f265d2cd2c5e96cc9fe460f35a891923e889f1b57d388ca35b/src
FILES=/oath/store/pkg/libepoxy-src/sha256-bf35712da9ea19f265d2cd2c5e96cc9fe460f35a891923e889f1b57d388ca35b/files
SOURCES='libepoxy-1.5.10.tar.xz'
VERSION=1.5.10
JOBS=$(nproc)
LIVE=/oath/store/pkg/libepoxy/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "libepoxy",
    "purl": "pkg:github/anholt/libepoxy@1.5.10",
    "version": "1.5.10"
  }
]
OATH_EOF
# libepoxy, shared, for EGL. It opens libEGL, and libGL for a desktop GL
# context, at run time, so it runs with mesa. The sandbox has no
# /usr/bin/env: the generator, not executable, runs through meson's python.
tar -xf "$SRC/$SOURCES"
cd "libepoxy-$VERSION"
chmod -x src/gen_dispatch.py
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release \
	-Degl=yes -Dglx=no -Dx11=false -Dtests=false -Ddocs=false
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
