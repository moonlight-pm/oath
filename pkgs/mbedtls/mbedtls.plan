#!oath-plan
{
  "name": "mbedtls",
  "produces": "pkg:mbedtls",
  "build_needs": [
    {
      "id": "pkg:busybox",
      "hash": "sha256-5c07428c094578850fa4fbf5ab3eb123d4d563178885cb4b32fae5deaa951d35"
    },
    {
      "id": "pkg:llvm",
      "hash": "sha256-bd45ef91795b5c3fe371714d4e13ef1b61e5d167d78040011f091dce30baebbd"
    },
    {
      "id": "pkg:make",
      "hash": "sha256-2c418177b4f53e3f953eed1b2364d992ded9c736a065c07ed09ca35a2c2e7682"
    },
    {
      "id": "pkg:mbedtls-src",
      "hash": "sha256-f8a9b6b100080f51361491258db2a4dad2d47d72fb53024aa0ac8b3090361895"
    }
  ],
  "run_needs": []
}
---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/mbedtls/
SRC=/oath/store/pkg/mbedtls-src/sha256-f8a9b6b100080f51361491258db2a4dad2d47d72fb53024aa0ac8b3090361895/src
FILES=/oath/store/pkg/mbedtls-src/sha256-f8a9b6b100080f51361491258db2a4dad2d47d72fb53024aa0ac8b3090361895/files
SOURCES='mbedtls-3.6.7.tar.bz2'
VERSION=3.6.7
JOBS=$(nproc)
LIVE=/oath/store/pkg/mbedtls/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "mbedtls",
    "purl": "pkg:generic/mbedtls@3.6.7",
    "version": "3.6.7"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd mbedtls-$VERSION
make -j"$JOBS" lib
mkdir -p /out/include /out/lib
cp -a include/mbedtls include/psa /out/include/
cp library/libmbedcrypto.a library/libmbedx509.a library/libmbedtls.a /out/lib/
