#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/dbus/
SRC=/oath/store/pkg/dbus-src/sha256-0f46a4e82c0294e1db356c84c3546a5b14350297da59024e1a93fddcb69d5911/src
FILES=/oath/store/pkg/dbus-src/sha256-0f46a4e82c0294e1db356c84c3546a5b14350297da59024e1a93fddcb69d5911/files
SOURCES='dbus-1.16.2.tar.xz'
VERSION=1.16.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/dbus/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "dbus",
    "purl": "pkg:generic/dbus@1.16.2",
    "version": "1.16.2"
  }
]
OATH_EOF
# libdbus and dbus-daemon, without systemd, X11 autolaunch, docs or
# tests. Python scripts the build runs are made non-executable, so meson
# runs them with its own python.
tar -xf "$SRC/$SOURCES"
cd "dbus-$VERSION"
find . -name '*.py' -exec chmod -x {} +
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release --wrap-mode=nodownload --localstatedir=/var \
	-Druntime_dir=/run -Dsystemd=disabled -Duser_session=false -Dx11_autolaunch=disabled \
	-Ddoxygen_docs=disabled -Dducktype_docs=disabled -Dxml_docs=disabled -Dqt_help=disabled \
	-Dmodular_tests=disabled -Dinstalled_tests=false -Dselinux=disabled -Dapparmor=disabled \
	-Dlibaudit=disabled -Dlaunchd=disabled -Dkqueue=disabled -Dvalgrind=disabled \
	-Depoll=enabled -Dinotify=enabled
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/." /out/
rm -rf /out/share/doc /out/lib/cmake
