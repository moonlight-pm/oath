#!oath-plan
{
  "name": "llvm",
  "produces": "pkg:llvm",
  "build_needs": [
    {
      "id": "pkg:busybox",
      "hash": "sha256-5c07428c094578850fa4fbf5ab3eb123d4d563178885cb4b32fae5deaa951d35"
    },
    {
      "id": "pkg:cmake",
      "hash": "sha256-fe3a080e37f9d14bc988b0f186ceede5d663783c9b05f9b917ea01dbeca892cd"
    },
    {
      "id": "pkg:llvm",
      "hash": "sha256-1a5d6cad24b01b2dcef476d260fb3a108471708948d661767e249d2653ed65ea"
    },
    {
      "id": "pkg:llvm-src",
      "hash": "sha256-8827d402efd2c49f29ee9ade7708a5322112ff8675369a755ce22fee43de9d71"
    },
    {
      "id": "pkg:make",
      "hash": "sha256-ade99e47287653412c2bfabcf7495c787598975dbe6155109cba2c81ae1431cf"
    },
    {
      "id": "pkg:ninja",
      "hash": "sha256-5bc16314b4fd4b440c7b9fbe8b7a2da8666ab21194d8daadcd2376294fadb422"
    },
    {
      "id": "pkg:python",
      "hash": "sha256-0d9ca4d5b471b54ef7d8094f9ad69759cec90921fabdaa9d5b903f66d837ec6e"
    }
  ],
  "run_needs": []
}
---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/llvm/
SRC=/oath/store/pkg/llvm-src/sha256-8827d402efd2c49f29ee9ade7708a5322112ff8675369a755ce22fee43de9d71/src
FILES=/oath/store/pkg/llvm-src/sha256-8827d402efd2c49f29ee9ade7708a5322112ff8675369a755ce22fee43de9d71/files
SOURCES='llvm-project-23.1.3.src.tar.xz musl-1.2.6.tar.gz linux-7.3-rc1.tar.gz'
VERSION=23.1.3
JOBS=$(nproc)
LIVE=/oath/store/pkg/llvm/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "llvm",
    "purl": "pkg:github/llvm/llvm-project@llvmorg-23.1.3",
    "version": "23.1.3"
  }
]
OATH_EOF
# Stage 1 of pkgs/bootstrap.sh as a plan: the previous pkg:llvm builds a
# fresh sysroot (Linux UAPI headers, musl, compiler-rt builtins,
# libunwind, libc++abi, libc++) and the tools. LLVM's CMake picks the
# release flags, as in stage 1.
unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS PKG_CONFIG_PATH
T=x86_64-unknown-linux-musl
for s in $SOURCES; do tar -xf "$SRC/$s"; done
LLVM=$PWD/llvm-project-$VERSION.src
MUSL=$(echo "$PWD"/musl-*)
LINUX=$(echo "$PWD"/linux-*)
P=/out
SYS=$P/sysroot

common_llvm="-DCMAKE_BUILD_TYPE=Release
 -DLLVM_APPEND_VC_REV=OFF
 -DLLVM_TARGETS_TO_BUILD=X86
 -DLLVM_DEFAULT_TARGET_TRIPLE=$T
 -DCLANG_DEFAULT_RTLIB=compiler-rt
 -DCLANG_DEFAULT_UNWINDLIB=libunwind
 -DCLANG_DEFAULT_CXX_STDLIB=libc++
 -DCLANG_DEFAULT_LINKER=lld
 -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF
 -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_DOCS=OFF
 -DCLANG_INCLUDE_TESTS=OFF -DCLANG_INCLUDE_DOCS=OFF
 -DLLVM_ENABLE_ZLIB=OFF -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_LIBXML2=OFF
 -DLLVM_ENABLE_TERMINFO=OFF -DLLVM_ENABLE_LIBEDIT=OFF -DLLVM_ENABLE_LIBPFM=OFF
 -DLLVM_ENABLE_BINDINGS=OFF -DCLANG_ENABLE_ARCMT=OFF
 -DCLANG_ENABLE_STATIC_ANALYZER=OFF -DLLVM_ENABLE_OCAMLDOC=OFF"
tools_targets="install-clang install-clang-resource-headers install-lld
 install-llvm-ar install-llvm-ranlib install-llvm-nm install-llvm-objcopy
 install-llvm-objdump install-llvm-readobj install-llvm-strip install-llvm-size
 install-llvm-strings install-llvm-symbolizer install-llvm-addr2line
 install-llvm-config"
tools="-DCMAKE_C_COMPILER=cc -DCMAKE_CXX_COMPILER=c++ -DCMAKE_ASM_COMPILER=cc
 -DCMAKE_AR=/bin/llvm-ar -DCMAKE_RANLIB=/bin/llvm-ranlib -DCMAKE_NM=/bin/llvm-nm"

# The sysroot. The kernel's headers_install needs rsync; `headers` and
# cpio do the same copy.
make -C "$LINUX" ARCH=x86_64 LLVM=1 headers
mkdir -p "$SYS/include"
(cd "$LINUX/usr/include" && find . -name '*.h' | cpio -pd "$SYS/include")
(cd "$MUSL" && ./configure --prefix=/ --target=x86_64-linux-musl \
	--disable-shared CC=cc AR=llvm-ar RANLIB=llvm-ranlib \
	LIBCC="$(cc -print-libgcc-file-name)" &&
	make -j"$JOBS" && make install DESTDIR="$SYS")

runtimes() { # build-dir install-prefix extra-cmake-args...
	b=$1
	prefix=$2
	shift 2
	# shellcheck disable=SC2086
	cmake -G Ninja -S "$LLVM/runtimes" -B "$b" $tools \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_COMPILER_TARGET=$T -DCMAKE_CXX_COMPILER_TARGET=$T \
		-DCMAKE_ASM_COMPILER_TARGET=$T \
		-DCMAKE_SYSROOT="$SYS" \
		-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
		-DLLVM_DEFAULT_TARGET_TRIPLE=$T \
		-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON \
		-DCMAKE_INSTALL_PREFIX="$prefix" "$@"
	ninja -C "$b" -j"$JOBS" install
}

runtimes b-builtins "$P/lib/clang/$(basename "$(cc -print-resource-dir)")" \
	-DLLVM_ENABLE_RUNTIMES=compiler-rt \
	-DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
	-DCOMPILER_RT_BUILD_BUILTINS=ON -DCOMPILER_RT_BUILD_CRT=ON \
	-DCOMPILER_RT_BUILD_SANITIZERS=OFF -DCOMPILER_RT_BUILD_XRAY=OFF \
	-DCOMPILER_RT_BUILD_LIBFUZZER=OFF -DCOMPILER_RT_BUILD_PROFILE=OFF \
	-DCOMPILER_RT_BUILD_MEMPROF=OFF -DCOMPILER_RT_BUILD_ORC=OFF \
	-DCOMPILER_RT_BUILD_CTX_PROFILE=OFF -DCOMPILER_RT_BUILD_GWP_ASAN=OFF \
	-DCOMPILER_RT_USE_LIBCXX=OFF \
	-DCMAKE_C_COMPILER_WORKS=ON -DCMAKE_CXX_COMPILER_WORKS=ON

# libunwind, libc++abi and libc++ go straight into the sysroot's lib/,
# where clang looks for them (not a per-target subdirectory).
runtimes b-cxx "$SYS" \
	-DLLVM_ENABLE_RUNTIMES="libunwind;libcxxabi;libcxx" \
	-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF \
	-DLIBUNWIND_ENABLE_SHARED=OFF -DLIBUNWIND_USE_COMPILER_RT=ON \
	-DLIBCXXABI_ENABLE_SHARED=OFF -DLIBCXXABI_USE_COMPILER_RT=ON \
	-DLIBCXXABI_HAS_CXA_THREAD_ATEXIT_IMPL=OFF \
	-DLIBCXXABI_USE_LLVM_UNWINDER=ON -DLIBCXXABI_ENABLE_STATIC_UNWINDER=ON \
	-DLIBCXXABI_STATICALLY_LINK_UNWINDER_IN_STATIC_LIBRARY=ON \
	-DLIBCXX_ENABLE_SHARED=OFF -DLIBCXX_USE_COMPILER_RT=ON \
	-DLIBCXX_HAS_MUSL_LIBC=ON -DLIBCXX_ENABLE_STATIC_ABI_LIBRARY=ON \
	-DLIBCXX_INCLUDE_BENCHMARKS=OFF -DLIBCXX_INCLUDE_TESTS=OFF \
	-DLIBCXXABI_INCLUDE_TESTS=OFF -DLIBUNWIND_INCLUDE_TESTS=OFF \
	-DLLVM_INCLUDE_TESTS=OFF
mv "$SYS/include/c++" cxx-include
# Stage 1 copies only the sysroot's include/ and lib/.
for d in "$SYS"/*; do
	case ${d##*/} in include | lib) ;; *) rm -rf "$d" ;; esac
done

# The tools, last: the sysroot steps above are quick and fail first.
# shellcheck disable=SC2086
cmake -G Ninja -S "$LLVM/llvm" -B b-llvm $common_llvm $tools \
	-DLLVM_ENABLE_PROJECTS="clang;lld" \
	-DLLVM_HOST_TRIPLE=$T \
	-DLLVM_BUILD_STATIC=ON -DLLVM_ENABLE_PIC=OFF \
	-DLLVM_ENABLE_LIBCXX=ON \
	-DCMAKE_EXE_LINKER_FLAGS="-static" \
	-DLLVM_ENABLE_THREADS=ON \
	-DCMAKE_INSTALL_PREFIX=/
# shellcheck disable=SC2086
DESTDIR="$P" ninja -C b-llvm -j"$JOBS" $tools_targets
# GNUInstallDirs puts a "/" prefix's files under usr/: flatten it.
if [ -d "$P/usr" ]; then
	cp -a "$P/usr/." "$P/"
	rm -rf "$P/usr"
fi
rm -rf "$P/share" "$P/include" "$P/lib/cmake" "$P/lib"/*.a

# clang finds libc++ headers next to itself (bin/../include/c++).
mkdir -p "$P/include"
mv cxx-include "$P/include/c++"

# The pack's clang finds its sysroot next to itself and links statically
# by default (there is no shared libc on Oath's base).
for drv in clang clang++; do
	printf '%s\n' '--sysroot=<CFGDIR>/../sysroot' -static \
		-Wno-unused-command-line-argument >"$P/bin/$drv.cfg"
done
# Names build scripts expect.
for pair in cc:clang c++:clang++ gcc:clang g++:clang++ cpp:clang-cpp \
	ar:llvm-ar ranlib:llvm-ranlib nm:llvm-nm objcopy:llvm-objcopy \
	objdump:llvm-objdump readelf:llvm-readelf strip:llvm-strip size:llvm-size \
	strings:llvm-strings addr2line:llvm-addr2line ld:ld.lld; do
	ln -sf "${pair#*:}" "$P/bin/${pair%%:*}"
done
[ -e "$P/bin/clang-cpp" ] || ln -sf clang "$P/bin/clang-cpp"
[ -e "$P/bin/llvm-readelf" ] || ln -sf llvm-readobj "$P/bin/llvm-readelf"
for drv in cc c++ gcc g++; do
	case $drv in c++ | g++) src=clang++ ;; *) src=clang ;; esac
	ln -sf "$src.cfg" "$P/bin/$drv.cfg"
done
