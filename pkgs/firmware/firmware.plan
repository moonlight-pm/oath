#!oath-plan
{
  "name": "firmware",
  "produces": "pkg:firmware",
  "build_needs": [
    {
      "id": "pkg:busybox",
      "hash": "sha256-5c07428c094578850fa4fbf5ab3eb123d4d563178885cb4b32fae5deaa951d35"
    },
    {
      "id": "pkg:firmware-src",
      "hash": "sha256-a026a2591548edfb6739a944d52083d72f4d88417cfeaaf6d1af24735550acec"
    }
  ],
  "run_needs": []
}
---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/firmware/
SRC=/oath/store/pkg/firmware-src/sha256-a026a2591548edfb6739a944d52083d72f4d88417cfeaaf6d1af24735550acec/src
FILES=/oath/store/pkg/firmware-src/sha256-a026a2591548edfb6739a944d52083d72f4d88417cfeaaf6d1af24735550acec/files
SOURCES='firmware/amdgpu/pitcairn_ce.bin firmware/amdgpu/pitcairn_k_smc.bin firmware/amdgpu/pitcairn_mc.bin firmware/amdgpu/pitcairn_me.bin firmware/amdgpu/pitcairn_pfp.bin firmware/amdgpu/pitcairn_rlc.bin firmware/amdgpu/pitcairn_smc.bin firmware/amdgpu/pitcairn_uvd.bin firmware/radeon/pitcairn_ce.bin firmware/radeon/PITCAIRN_ce.bin firmware/radeon/pitcairn_k_smc.bin firmware/radeon/PITCAIRN_mc2.bin firmware/radeon/pitcairn_mc.bin firmware/radeon/PITCAIRN_mc.bin firmware/radeon/pitcairn_me.bin firmware/radeon/PITCAIRN_me.bin firmware/radeon/pitcairn_pfp.bin firmware/radeon/PITCAIRN_pfp.bin firmware/radeon/pitcairn_rlc.bin firmware/radeon/PITCAIRN_rlc.bin firmware/radeon/pitcairn_smc.bin firmware/radeon/PITCAIRN_smc.bin firmware/tigon/tg357766.bin firmware/tigon/tg3.bin firmware/tigon/tg3_tso5.bin firmware/tigon/tg3_tso.bin'
VERSION=20260916
JOBS=$(nproc)
LIVE=/oath/store/pkg/firmware/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "firmware",
    "purl": "pkg:generic/firmware@20260916",
    "version": "20260916"
  }
]
OATH_EOF
mkdir -p /out/lib
cp -r "$SRC/firmware" /out/lib/firmware
