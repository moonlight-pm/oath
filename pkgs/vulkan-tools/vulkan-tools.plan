#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/vulkan-tools/
SRC=/oath/store/pkg/vulkan-tools-src/sha256-89ead4fa5ae64957e4b6ab1f75e3ff4f946a3583f2cdad9efb6575283d7b849b/src
FILES=/oath/store/pkg/vulkan-tools-src/sha256-89ead4fa5ae64957e4b6ab1f75e3ff4f946a3583f2cdad9efb6575283d7b849b/files
SOURCES='Vulkan-Tools-1.4.365.tar.gz'
VERSION=1.4.365
JOBS=$(nproc)
LIVE=/oath/store/pkg/vulkan-tools/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "vulkan-tools",
    "purl": "pkg:github/KhronosGroup/Vulkan-Tools@v1.4.365",
    "version": "1.4.365"
  }
]
OATH_EOF
# vulkaninfo, with X11 (xcb, Xlib) and Wayland surfaces.
tar -xf "$SRC/$SOURCES"
cd "Vulkan-Tools-$VERSION"
cmake -S . -B build -DCMAKE_INSTALL_PREFIX="$LIVE" -DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_PREFIX_PATH=/oath/store/pkg/vulkan-headers/live \
	-DBUILD_CUBE=OFF -DBUILD_ICD=OFF -DBUILD_TESTS=OFF -DBUILD_VULKANINFO=ON
cmake --build build -j"$JOBS"
DESTDIR=/tmp/dest cmake --install build
cp -a "/tmp/dest$LIVE/bin" /out/
