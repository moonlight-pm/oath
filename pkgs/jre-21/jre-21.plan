#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/jre-21/
SRC=/oath/store/pkg/jre-21-src/sha256-0d53c4e8240c189a5f3fbf7b53afd40ca0b1e1ad9699615bdf66dfb4cae7fde2/src
FILES=/oath/store/pkg/jre-21-src/sha256-0d53c4e8240c189a5f3fbf7b53afd40ca0b1e1ad9699615bdf66dfb4cae7fde2/files
SOURCES='OpenJDK21U-jre_x64_linux_hotspot_21.0.13_9.tar.gz'
VERSION=21.0.13+9
JOBS=$(nproc)
LIVE=/oath/store/pkg/jre-21/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "jre-21",
    "purl": "pkg:generic/temurin-jre@21.0.13%2B9",
    "version": "21.0.13+9"
  }
]
OATH_EOF
# Output: libexec/jre-21/, Temurin's tree as it ships. Its programs name
# /lib64/ld-linux-x86-64.so.2; Oath has no /lib64 (R17), so patchelf points
# them at /lib's loader. Its libraries load libjvm.so, which is in
# lib/server/ and found there because java loads it first by path; the link
# in lib/ says the same to the check of what each library loads.
tar -xzf "$SRC/$SOURCES" --no-same-owner
d=/out/libexec/jre-21
mkdir -p /out/libexec
mv "jdk-$VERSION-jre" "$d"
grep -qx "JAVA_RUNTIME_VERSION=\"$VERSION-LTS\"" "$d/release"
for f in "$d"/bin/* "$d"/lib/jexec "$d"/lib/jspawnhelper; do
	patchelf --set-interpreter /lib/ld-linux-x86-64.so.2 "$f"
done
ln -s server/libjvm.so "$d/lib/libjvm.so"

# It runs a class (compiled by pkg:jdk-21) that starts a process, which
# goes through lib/jspawnhelper.
"$d/bin/java" -version 2>&1 | grep -q "Temurin-$VERSION"
mkdir /tmp/t
printf '%s\n' 'public class T { public static void main(String[] a) throws Exception {' \
	'System.out.println(new ProcessBuilder("true").start().waitFor() == 0 ? "ok" : "no"); } }' >/tmp/t/T.java
/oath/store/pkg/jdk-21/live/libexec/jdk-21/bin/javac --release 21 -d /tmp/t /tmp/t/T.java
[ "$("$d/bin/java" -cp /tmp/t T)" = ok ]
