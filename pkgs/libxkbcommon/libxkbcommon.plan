#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/libxkbcommon/
SRC=/oath/store/pkg/libxkbcommon-src/sha256-1ba57f85f94c2a18a9ce75c854ffaad884710c8fa8004ffd432ccac186e9b205/src
FILES=/oath/store/pkg/libxkbcommon-src/sha256-1ba57f85f94c2a18a9ce75c854ffaad884710c8fa8004ffd432ccac186e9b205/files
SOURCES='libxkbcommon-xkbcommon-1.13.2.tar.gz'
VERSION=1.13.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/libxkbcommon/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "libxkbcommon",
    "purl": "pkg:github/xkbcommon/libxkbcommon@xkbcommon-1.13.2",
    "version": "1.13.2"
  }
]
OATH_EOF
# libxkbcommon, shared, reading xkeyboard-config's slot for keymaps and
# libX11's for Compose. No X11 or Wayland tools, no xkbregistry
# (libxml2), no docs.
tar -xf "$SRC/$SOURCES"
cd "libxkbcommon-xkbcommon-$VERSION"
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release \
	-Dxkb-config-root=/oath/store/pkg/xkeyboard-config/live/share/xkeyboard-config-2 \
	-Dx-locale-root=/oath/store/pkg/libx11/live/share/X11/locale \
	-Denable-x11=false -Denable-wayland=false -Denable-xkbregistry=false -Denable-tools=false \
	-Denable-docs=false -Denable-bash-completion=false
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
