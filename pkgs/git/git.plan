#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/git/
SRC=/oath/store/pkg/git-src/sha256-2f9d1b540ff44168789618a8fbc3898267e2b5351d1f098711ce00d14595f9d1/src
FILES=/oath/store/pkg/git-src/sha256-2f9d1b540ff44168789618a8fbc3898267e2b5351d1f098711ce00d14595f9d1/files
SOURCES='git-2.56.0.tar.xz'
VERSION=2.56.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/git/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "git",
    "purl": "pkg:generic/git@2.56.0",
    "version": "2.56.0"
  }
]
OATH_EOF
# git and its helpers (libexec/git-core), linked against libcurl for
# https. NO_PERL drops send-email, svn and the cvs commands; NO_PYTHON
# git-p4; NO_TCLTK gitk and git-gui. CFLAGS has no -g, so no debug info
# names the compiler's store path.
tar -xf "$SRC/$SOURCES"
cd "git-$VERSION"
opts="prefix=$LIVE gitexecdir=$LIVE/libexec/git-core NO_GETTEXT=1 NO_TCLTK=1 NO_PYTHON=1 NO_PERL=1"
opts="$opts NO_RUST=1 NO_OPENSSL=1 USE_LIBPCRE2=1 INSTALL_SYMLINKS=1"
opts="$opts CURL_CONFIG=/oath/store/pkg/curl/live/bin/curl-config"
make -j"$JOBS" $opts CFLAGS="$CFLAGS" all
make $opts CFLAGS="$CFLAGS" install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/libexec" "/tmp/dest$LIVE/share" /out/
rm -rf /out/share/perl5 /out/share/gitweb
