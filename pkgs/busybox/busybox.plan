---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/busybox/
SRC=/oath/store/pkg/busybox-src/sha256-f47263b70e030c6395d5a0957fb6ab75aea249dc91a38d305b1937b02751cc31/src
FILES=/oath/store/pkg/busybox-src/sha256-f47263b70e030c6395d5a0957fb6ab75aea249dc91a38d305b1937b02751cc31/files
SOURCES='busybox-1.38.0.tar.bz2'
VERSION=1.38.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/busybox/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "busybox",
    "purl": "pkg:generic/busybox@1.38.0",
    "version": "1.38.0"
  }
]
OATH_EOF
# busybox from pkgs/busybox/config (defconfig, static, no init/tc).
tar -xf "$SRC/$SOURCES"
cd busybox-$VERSION
cp "$FILES/config" .config
make HOSTCC=cc CC=cc oldconfig </dev/null >/dev/null
make HOSTCC=cc CC=cc AR=ar STRIP=strip -j"$JOBS" busybox
mkdir -p /out/bin
cp busybox /out/bin/busybox
for a in $(./busybox --list); do
	[ "$a" = busybox ] || ln -s busybox "/out/bin/$a"
done
