#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/wireplumber/
SRC=/oath/store/pkg/wireplumber-src/sha256-c92c2b5a49c8d6592b2f7017ab41277e2106b587942e244458bf20efbf52137e/src
FILES=/oath/store/pkg/wireplumber-src/sha256-c92c2b5a49c8d6592b2f7017ab41277e2106b587942e244458bf20efbf52137e/files
SOURCES='wireplumber-0.5.18.tar.gz lua-5.5.0.tar.gz lua_5.5.0-1_patch.zip'
VERSION=0.5.18
JOBS=$(nproc)
LIVE=/oath/store/pkg/wireplumber/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "wireplumber",
    "purl": "pkg:generic/wireplumber@0.5.18",
    "version": "0.5.18"
  }
]
OATH_EOF
# WirePlumber with its daemon, modules and wpctl; no introspection, docs,
# systemd or elogind. share/wireplumber/wireplumber.conf.d/50-oath.conf
# turns off what needs Bluetooth, logind or portals.
tar -xf "$SRC/wireplumber-$VERSION.tar.gz"
cd "wireplumber-$VERSION"
mkdir -p subprojects/packagecache
cp "$SRC/lua-5.5.0.tar.gz" "$SRC/lua_5.5.0-1_patch.zip" subprojects/packagecache/
find . -name '*.py' -exec chmod -x {} +
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release --wrap-mode=nodownload \
	-Dsystem-lua=false -Dintrospection=disabled -Ddoc=disabled -Dsystemd=disabled \
	-Delogind=disabled -Dsystemd-user-service=false -Dsystemd-system-service=false \
	-Dtests=false -Ddbus-tests=false
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/." /out/
rm -rf /out/lib/liblua* /out/include/lua* /out/lib/pkgconfig/lua* /out/share/locale /out/lib/cmake
mkdir -p /out/share/wireplumber/wireplumber.conf.d
cp "$FILES/50-oath.conf" /out/share/wireplumber/wireplumber.conf.d/
