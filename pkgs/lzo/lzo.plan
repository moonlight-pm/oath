      "id": "pkg:busybox",
      "hash": "sha256-5c07428c094578850fa4fbf5ab3eb123d4d563178885cb4b32fae5deaa951d35"
    },
    {
      "id": "pkg:llvm",
      "hash": "sha256-bd45ef91795b5c3fe371714d4e13ef1b61e5d167d78040011f091dce30baebbd"
    },
    {
      "id": "pkg:lzo-src",
      "hash": "sha256-3caafba4dc1d095dfb96e4e62b852e149a4d080eb9f860010d95110ca0cf2ca6"
