---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/lzo/
SRC=/oath/store/pkg/lzo-src/sha256-3caafba4dc1d095dfb96e4e62b852e149a4d080eb9f860010d95110ca0cf2ca6/src
FILES=/oath/store/pkg/lzo-src/sha256-3caafba4dc1d095dfb96e4e62b852e149a4d080eb9f860010d95110ca0cf2ca6/files
SOURCES='lzo-2.10.tar.gz'
VERSION=2.10
JOBS=$(nproc)
LIVE=/oath/store/pkg/lzo/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "lzo",
    "purl": "pkg:generic/lzo@2.10",
    "version": "2.10"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd lzo-$VERSION
./configure --prefix="$LIVE" --disable-shared --enable-static
make -j"$JOBS"
make install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
