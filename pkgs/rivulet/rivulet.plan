---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/rivulet/
SRC=/oath/store/pkg/rivulet-src/sha256-1d315bb8edfc31235612e42ac19336341f2e87bdf9f795e70a0fdef7bd903fa7/src
FILES=/oath/store/pkg/rivulet-src/sha256-1d315bb8edfc31235612e42ac19336341f2e87bdf9f795e70a0fdef7bd903fa7/files
SOURCES='rivulet'
VERSION=0.1.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/rivulet/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "rivulet",
    "purl": "pkg:generic/rivulet@0.1.0",
    "version": "0.1.0"
  }
]
OATH_EOF
# rivulet and River's protocol XML (share/river-protocols), which window
# managers such as sola-river build against.
cp -a "$SRC/rivulet" /tmp/rivulet
cd /tmp/rivulet
make -j"$JOBS" PREFIX="$LIVE"
make install PREFIX="$LIVE" DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/share" /out/
