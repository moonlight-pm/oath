#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/wayland-i386/
SRC=/oath/store/pkg/wayland-i386-src/sha256-3df7d9085b7c8593013fa76da0a2f2c8019cf76599a3ad164b3ba206654e755b/src
FILES=/oath/store/pkg/wayland-i386-src/sha256-3df7d9085b7c8593013fa76da0a2f2c8019cf76599a3ad164b3ba206654e755b/files
SOURCES='wayland-1.26.0.tar.xz'
VERSION=1.26.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/wayland-i386/live
LIBDIR=lib32
export CC="cc -m32" CXX="c++ -m32" AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH= pc=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | */glibc-i386/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib32" ] && LDFLAGS="$LDFLAGS -L$d/lib32"
	[ -d "$d/lib32/pkgconfig" ] && PKG_CONFIG_PATH="${PKG_CONFIG_PATH:+$PKG_CONFIG_PATH:}$d/lib32/pkgconfig"
	[ -d "$d/lib/pkgconfig" ] && pc="${pc:+$pc:}$d/lib/pkgconfig"
done
PKG_CONFIG_PATH="$PKG_CONFIG_PATH${pc:+:$pc}"
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "wayland-i386",
    "purl": "pkg:generic/wayland@1.26.0",
    "version": "1.26.0"
  }
]
OATH_EOF
# The Wayland libraries and wayland-scanner, without docs, tests or DTD
# validation (libxml2). For i386 the libraries alone: the build runs the
# x86_64 pack's scanner, and a pack's bin/ is linked into /bin.
tar -xf "$SRC/$SOURCES"
cd "wayland-$VERSION"
scanner=true
[ "$LIBDIR" = lib ] || scanner=false
meson setup build --prefix="$LIVE" --libdir="$LIBDIR" --buildtype=release \
	-Ddocumentation=false -Ddtd_validation=false -Dtests=false -Dscanner=$scanner
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/$LIBDIR" /out/
for d in bin share; do
	if [ -d "/tmp/dest$LIVE/$d" ]; then cp -a "/tmp/dest$LIVE/$d" /out/; fi
done
