#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/glib/
SRC=/oath/store/pkg/glib-src/sha256-f4a8ba7c25f44eb9e2b7058ead5978211d32b76f704920381054a4f47719c934/src
FILES=/oath/store/pkg/glib-src/sha256-f4a8ba7c25f44eb9e2b7058ead5978211d32b76f704920381054a4f47719c934/files
SOURCES='glib-2.90.1.tar.xz'
VERSION=2.90.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/glib/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "glib",
    "purl": "pkg:generic/glib@2.90.1",
    "version": "2.90.1"
  }
]
OATH_EOF
# GLib without introspection, docs, tests, libmount, SELinux or sysprof.
# Its installed Python tools (glib-mkenums, ...) name /bin/python3: the
# sandbox and Oath have no /usr/bin/env. Python scripts the build runs
# are made non-executable, so meson runs them with its own python.
tar -xf "$SRC/$SOURCES"
cd "glib-$VERSION"
find . -name '*.py' -exec chmod -x {} +
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release --wrap-mode=nodownload \
	-Dintrospection=disabled -Ddocumentation=false -Dman-pages=disabled -Dtests=false \
	-Dinstalled_tests=false -Dsysprof=disabled -Dselinux=disabled -Dlibmount=disabled \
	-Dlibelf=disabled -Ddtrace=disabled -Dsystemtap=disabled -Dnls=disabled \
	-Dglib_debug=disabled -Dfile_monitor_backend=inotify
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" "/tmp/dest$LIVE/share" /out/
for f in /out/bin/*; do
	sed -i '1s|^#!/usr/bin/env python3$|#!/bin/python3|' "$f"
done
rm -rf /out/share/locale /out/share/bash-completion /out/share/gdb
