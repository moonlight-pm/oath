#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/libxfont2/
SRC=/oath/store/pkg/libxfont2-src/sha256-8ba3471b9ec631d558a03010c2afc81f7b6f26159d082a37c91135bcef43edd4/src
FILES=/oath/store/pkg/libxfont2-src/sha256-8ba3471b9ec631d558a03010c2afc81f7b6f26159d082a37c91135bcef43edd4/files
SOURCES='libXfont2-2.0.9.tar.xz'
VERSION=2.0.9
JOBS=$(nproc)
LIVE=/oath/store/pkg/libxfont2/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "libxfont2",
    "purl": "pkg:generic/libXfont2@2.0.9",
    "version": "2.0.9"
  }
]
OATH_EOF
# libXfont2, shared: the built-in fonts and the PCF and BDF readers, no
# FreeType.
tar -xf "$SRC/$SOURCES"
cd "libXfont2-$VERSION"
./configure --prefix="$LIVE" --disable-static --disable-freetype --disable-devel-docs \
	--without-xmlto --without-fop
make -j"$JOBS"
make install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
rm -f /out/lib/*.la
