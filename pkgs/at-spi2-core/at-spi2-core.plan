#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/at-spi2-core/
SRC=/oath/store/pkg/at-spi2-core-src/sha256-998f0e5dfcf85ee7595ea4149cb55d8a465d23887bc0f02c430d6f7108456ee6/src
FILES=/oath/store/pkg/at-spi2-core-src/sha256-998f0e5dfcf85ee7595ea4149cb55d8a465d23887bc0f02c430d6f7108456ee6/files
SOURCES='at-spi2-core-2.62.1.tar.xz'
VERSION=2.62.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/at-spi2-core/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "at-spi2-core",
    "purl": "pkg:generic/at-spi2-core@2.62.1",
    "version": "2.62.1"
  }
]
OATH_EOF
# at-spi2-core without X11, introspection, docs or systemd; the a11y bus
# is found over the session bus.
tar -xf "$SRC/$SOURCES"
cd "at-spi2-core-$VERSION"
for p in "$FILES"/patches/*.patch; do
	echo "patch ${p##*/}"
	patch -p1 -i "$p"
done
find . -name '*.py' -exec chmod -x {} +
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release --wrap-mode=nodownload \
	-Dx11=disabled -Dintrospection=disabled -Ddocs=false -Duse_systemd=false \
	-Ddefault_bus=dbus-daemon -Ddbus_daemon=/bin/dbus-daemon -Dgtk2_atk_adaptor=false \
	-Ddbus_glib=disabled
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/." /out/
rm -rf /out/lib/python* /out/share/locale
