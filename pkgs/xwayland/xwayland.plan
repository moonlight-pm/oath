#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/xwayland/
SRC=/oath/store/pkg/xwayland-src/sha256-9342a73aba38c9420f2fbb1fc65cd9323fb2d7f2fc5b2f388a1314b7e057040e/src
FILES=/oath/store/pkg/xwayland-src/sha256-9342a73aba38c9420f2fbb1fc65cd9323fb2d7f2fc5b2f388a1314b7e057040e/files
SOURCES='xwayland-24.1.14.tar.xz'
VERSION=24.1.14
JOBS=$(nproc)
LIVE=/oath/store/pkg/xwayland/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "xwayland",
    "purl": "pkg:generic/xwayland@24.1.14",
    "version": "24.1.14"
  }
]
OATH_EOF
# Xwayland with glamor on GBM (DRI3) and GLX, SHA-1 from nettle and the
# built-in fonts. Keymaps are compiled by xkbcomp from xkeyboard-config,
# both in their slots. No XDMCP, secure RPC (libtirpc), libdecor or
# libei. GLX links libGL, and Mesa's gl.pc needs the X libraries' .pc
# files to resolve.
tar -xf "$SRC/$SOURCES"
cd "xwayland-$VERSION"
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release \
	-Dglamor=true -Ddri3=true -Ddrm=true -Dglx=true -Dsha1=libnettle -Dxvfb=false \
	-Dxwayland_ei=false -Dlibdecor=false -Dxdmcp=false -Dxdm-auth-1=false -Dsecure-rpc=false \
	-Dxcsecurity=false -Dxf86bigfont=false -Dxselinux=false -Dlisten_tcp=false \
	-Dsystemd_notify=false -Dlibunwind=false -Ddtrace=false \
	-Ddocs=false -Ddevel-docs=false -Ddocs-pdf=false \
	-Dxkb_dir=/oath/store/pkg/xkeyboard-config/live/share/X11/xkb \
	-Dxkb_bin_dir=/oath/store/pkg/xkbcomp/live/bin -Ddefault_font_path=built-ins
grep -q '#define XWL_HAS_GLAMOR 1' build/include/xwayland-config.h || { echo "no glamor (gbm?)"; exit 1; }
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/lib" /out/
