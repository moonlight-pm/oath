#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/postgresql/
SRC=/oath/store/pkg/postgresql-src/sha256-d1e9ff473247e97fcf79c4f9b3c276ad4a6624fdd5cd4c3dbb8e968cec4973c0/src
FILES=/oath/store/pkg/postgresql-src/sha256-d1e9ff473247e97fcf79c4f9b3c276ad4a6624fdd5cd4c3dbb8e968cec4973c0/files
SOURCES='postgresql-18.6.tar.bz2'
VERSION=18.6
JOBS=$(nproc)
LIVE=/oath/store/pkg/postgresql/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "postgresql",
    "purl": "pkg:generic/postgresql@18.6",
    "version": "18.6"
  }
]
OATH_EOF
# Output: bin/, lib/ (libpq), its modules in lib/postgresql, include/ and
# share/. The build puts modules in lib/ when the prefix has "postgres" in its
# path, as this one does, and /lib would link them all: pkglibdir says where.
tar -xf "$SRC/$SOURCES"
cd "postgresql-$VERSION"
./configure --prefix="$LIVE" --libdir="$LIVE/$LIBDIR" --with-openssl --with-icu --with-libxml \
	--with-readline --with-zstd --with-uuid=e2fs --disable-rpath
mods="pkglibdir=$LIVE/$LIBDIR/postgresql"
make -j"$JOBS" world-bin "$mods"
make install-world-bin DESTDIR=/tmp/dest "$mods"
cp -a "/tmp/dest$LIVE/." /out/
rm -f "/out/$LIBDIR"/*.a

# It runs. The sandbox is root, which the server refuses, so no server here.
export LD_LIBRARY_PATH="/out/$LIBDIR"
/out/bin/postgres --version | grep -q " $VERSION\$"
/out/bin/psql --version | grep -q " $VERSION\$"
/out/bin/pg_config --pkglibdir | grep -q "/$LIBDIR/postgresql\$"
