---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/openssh/
SRC=/oath/store/pkg/openssh-src/sha256-e4243d9f4decf34e7efce1a618b1623e5b0c350c27079a05ccf09d7e4eeb719a/src
FILES=/oath/store/pkg/openssh-src/sha256-e4243d9f4decf34e7efce1a618b1623e5b0c350c27079a05ccf09d7e4eeb719a/files
SOURCES='openssh-10.6p1.tar.gz'
VERSION=10.6p1
JOBS=$(nproc)
LIVE=/oath/store/pkg/openssh/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "openssh",
    "purl": "pkg:generic/openssh@10.6p1",
    "version": "10.6p1"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd openssh-$VERSION
./configure --prefix=/ --sysconfdir=/etc/ssh --without-openssl \
	--with-privsep-path=/var/empty --disable-strip --without-pam \
	--without-selinux --without-kerberos5 --without-ldns \
	--without-security-key-builtin --with-default-path=/bin \
	--with-sftp-server=/bin/sftp-server
make -j"$JOBS" ssh scp sftp sftp-server ssh-keygen
mkdir -p /out/bin
cp ssh scp sftp sftp-server ssh-keygen /out/bin/
