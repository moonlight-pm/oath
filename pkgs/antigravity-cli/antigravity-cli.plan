---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/antigravity-cli/
SRC=/oath/store/pkg/antigravity-cli-src/sha256-9da2b29d5cd79c9904ec7d09feb59099804416156a696886ae8f8427a1bc1000/src
FILES=/oath/store/pkg/antigravity-cli-src/sha256-9da2b29d5cd79c9904ec7d09feb59099804416156a696886ae8f8427a1bc1000/files
SOURCES='agy_cli_linux_x64_musl.tar.gz'
VERSION=1.5.10
JOBS=$(nproc)
LIVE=/oath/store/pkg/antigravity-cli/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "antigravity-cli",
    "purl": "pkg:github/google-antigravity/antigravity-cli@1.5.10",
    "version": "1.5.10"
  }
]
OATH_EOF
# The vendor's binary in libexec/, and bin/agy, which keeps it from
# updating itself: the store holds the version, and a newer one is a new
# pin in pkgs/antigravity-cli. Its updater's only switch is
# AGY_CLI_DISABLE_AUTO_UPDATE, read as the exact string "true". It is a
# static Go program, so its TLS roots are pkg:certs' unless SSL_CERT_FILE
# names others: there is no /etc/ssl.
export HOME=/tmp/home
mkdir -p "$HOME" /out/bin /out/libexec/antigravity-cli
tar -xzf "$SRC/agy_cli_linux_x64_musl.tar.gz" --no-same-owner -C /out/libexec/antigravity-cli antigravity
b=/out/libexec/antigravity-cli/antigravity
chmod 755 "$b"
cat >/out/bin/agy <<EOT
#!/bin/sh
# Antigravity CLI $VERSION, built here from its recipe (R31). Updates are a
# new pin in Oath's pkgs/antigravity-cli, so its own updater is off.
: "\${SSL_CERT_FILE:=/oath/store/pkg/certs/live/ssl/cert.pem}"
export SSL_CERT_FILE
AGY_CLI_DISABLE_AUTO_UPDATE=true exec $LIVE/libexec/antigravity-cli/antigravity "\$@"
EOT
chmod 755 /out/bin/agy
AGY_CLI_DISABLE_AUTO_UPDATE=true "$b" --version 2>&1 | grep -qF "$VERSION"
