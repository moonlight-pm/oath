   git_exe = 'git'
   patch_exe = 'patch'
 
+# A source tarball has no .git. CEF_TARBALL_COMMIT ("<hash> <commit number>
+# <patch version>") answers for CEF's own tree what git would: its version
+# comes from these. Chromium's tree stays a non-checkout, patched by `patch`.
+_TARBALL = os.environ.get('CEF_TARBALL_COMMIT', '').split()
+
+
+def _tarball(path):
+  return len(_TARBALL) == 3 and os.path.isfile(
+      os.path.join(path, 'VERSION.in'))
+
 
