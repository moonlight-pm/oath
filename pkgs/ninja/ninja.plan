---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/ninja/
SRC=/oath/store/pkg/ninja-src/sha256-cac7eee4220046c51c9d62670a3a87693003f50dcb3b936f76f5e8876d04b39e/src
FILES=/oath/store/pkg/ninja-src/sha256-cac7eee4220046c51c9d62670a3a87693003f50dcb3b936f76f5e8876d04b39e/files
SOURCES='ninja-1.13.2.tar.gz'
VERSION=1.13.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/ninja/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "ninja",
    "purl": "pkg:github/ninja-build/ninja@v1.13.2",
    "version": "1.13.2"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd ninja-$VERSION
# BUILD_TESTING would fetch googletest.
cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
make -C build -j"$JOBS" ninja
mkdir -p /out/bin
cp build/ninja /out/bin/ninja
