#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/font-noto-cjk/
SRC=/oath/store/pkg/font-noto-cjk-src/sha256-175778b528da13eb8d7fa36fae15d27fab5455ef9dde11eb0205315bf8b62a87/src
FILES=/oath/store/pkg/font-noto-cjk-src/sha256-175778b528da13eb8d7fa36fae15d27fab5455ef9dde11eb0205315bf8b62a87/files
SOURCES='NotoSansCJK-Regular.ttc NotoSansCJK-Bold.ttc NotoSerifCJK-Regular.ttc NotoSerifCJK-Bold.ttc Noto-CJK-LICENSE'
VERSION=20240730
JOBS=$(nproc)
LIVE=/oath/store/pkg/font-noto-cjk/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "font-noto-cjk",
    "purl": "pkg:github/notofonts/noto-cjk@Serif2.003",
    "version": "20240730"
  }
]
OATH_EOF
# share/fonts/noto-cjk: the four collections and the licence.
mkdir -p /out/share/fonts/noto-cjk
cp "$SRC"/*.ttc /out/share/fonts/noto-cjk/
cp "$SRC/Noto-CJK-LICENSE" /out/share/fonts/noto-cjk/LICENSE
