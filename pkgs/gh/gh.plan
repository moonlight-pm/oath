0.mod gomod/golang.org/x/crypto/@v/v0.58.0.zip gomod/golang.org/x/mod/@v/v0.41.0.mod gomod/golang.org/x/mod/@v/v0.41.0.zip gomod/golang.org/x/net/@v/v0.62.0.mod gomod/golang.org/x/net/@v/v0.62.0.zip gomod/golang.org/x/sync/@v/v0.24.0.mod gomod/golang.org/x/sync/@v/v0.24.0.zip gomod/golang.org/x/sys/@v/v0.49.0.mod gomod/golang.org/x/sys/@v/v0.49.0.zip gomod/golang.org/x/term/@v/v0.47.0.mod gomod/golang.org/x/term/@v/v0.47.0.zip gomod/golang.org/x/text/@v/v0.43.0.mod gomod/golang.org/x/text/@v/v0.43.0.zip gomod/google.golang.org/genproto/googleapis/api/@v/v0.0.0-20260706201446-f0a921348800.mod gomod/google.golang.org/genproto/googleapis/api/@v/v0.0.0-20260706201446-f0a921348800.zip gomod/google.golang.org/genproto/googleapis/rpc/@v/v0.0.0-20260706201446-f0a921348800.mod gomod/google.golang.org/genproto/googleapis/rpc/@v/v0.0.0-20260706201446-f0a921348800.zip gomod/google.golang.org/grpc/@v/v1.84.0.mod gomod/google.golang.org/grpc/@v/v1.84.0.zip gomod/google.golang.org/protobuf/@v/v1.36.12.mod gomod/google.golang.org/protobuf/@v/v1.36.12.zip gomod/gopkg.in/yaml.v3/@v/v3.0.1.mod gomod/gopkg.in/yaml.v3/@v/v3.0.1.zip gomod/k8s.io/klog/v2/@v/v2.140.0.mod gomod/k8s.io/klog/v2/@v/v2.140.0.zip'
VERSION=2.103.3
JOBS=$(nproc)
LIVE=/oath/store/pkg/gh/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "gh",
    "purl": "pkg:golang/github.com/cli/cli/v2@2.103.3",
    "version": "2.103.3"
  }
]
OATH_EOF
# Output: libexec/gh/gh, static; bin/gh, which turns gh's update notice off (the
# store holds the version, and a newer one is a new pin in pkgs/gh) and names
# itself by its slot path (GH_PATH), so the git credential helper `gh auth
# setup-git` writes outlives the next update; every licence the program carries
# in share/doc/gh; and components.json naming each linked module.
export HOME=/tmp/home GOCACHE=/tmp/gocache GOPATH=/tmp/gopath GOMODCACHE=/tmp/gomod \
	CGO_ENABLED=0 GOSUMDB=off GOPROXY="file://$SRC/gomod" GOFLAGS='-mod=readonly -trimpath'
mkdir -p "$HOME" /tmp/gh /out/bin /out/libexec/gh /out/share/doc/gh
cd /tmp/gh
tar -xzf "$SRC/gh-$VERSION.tar.gz" --no-same-owner --strip-components=1
[ ! -f "$FILES/go.mod" ] || cp "$FILES/go.mod" "$FILES/go.sum" .
go build -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=$VERSION \
	-X github.com/cli/cli/v2/internal/build.Date=0000-00-00" -o /out/libexec/gh/gh ./cmd/gh
cp LICENSE /out/share/doc/gh/
(cd "$GOMODCACHE" && find . \( -path ./cache -o -name testdata \) -prune -o -type f \( -iname 'LICEN[CS]E*' -o -iname 'NOTICE*' \) \
	-exec cp --parents {} /out/share/doc/gh/ \;)
chmod -R u+w "$GOMODCACHE" /out/share/doc/gh
go-components gh "$VERSION" "pkg:golang/github.com/cli/cli/v2@$VERSION" /out/libexec/gh/gh >/out/components.json
cat >/out/bin/gh <<EOT
#!/bin/sh
# GitHub CLI $VERSION. Updates are a new pin in Oath's pkgs/gh, so gh's update
# notice is off.
export GH_NO_UPDATE_NOTIFIER=1 GH_PATH=$LIVE/bin/gh
exec $LIVE/libexec/gh/gh "\$@"
EOT
chmod 755 /out/bin/gh
/out/libexec/gh/gh --version | grep -q "^gh version $VERSION "
