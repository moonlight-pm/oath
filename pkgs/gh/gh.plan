#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/gh/
SRC=/oath/store/pkg/gh-src/sha256-975d04a26faf57d39972a8e5ccd57ed20b28cc699f8595df926582bd1a034dfd/src
FILES=/oath/store/pkg/gh-src/sha256-975d04a26faf57d39972a8e5ccd57ed20b28cc699f8595df926582bd1a034dfd/files
SOURCES='gh_2.103.3_linux_amd64.tar.gz'
VERSION=2.103.3
JOBS=$(nproc)
LIVE=/oath/store/pkg/gh/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "gh",
    "purl": "pkg:golang/github.com/cli/cli/v2@2.103.3",
    "version": "2.103.3"
  }
]
OATH_EOF
# The vendor's static gh in libexec/, and bin/gh, which turns gh's update
# notice off (the store holds the version, and a newer one is a new pin
# in pkgs/gh), gives it curl's CA bundle when the machine names none, and
# names itself by its slot path (GH_PATH), so the git credential helper
# `gh auth setup-git` writes outlives the next update.
export HOME=/tmp/home
mkdir -p "$HOME" /out/bin /out/libexec/gh /out/share/doc/gh
tar -xzf "$SRC/gh_${VERSION}_linux_amd64.tar.gz" --no-same-owner
d=gh_${VERSION}_linux_amd64
cp "$d/bin/gh" /out/libexec/gh/gh
cp "$d/LICENSE" /out/share/doc/gh/
cat >/out/bin/gh <<EOT
#!/bin/sh
# GitHub CLI $VERSION, the vendor's build (R7). Updates are a new pin in
# Oath's pkgs/gh, so gh's update notice is off.
export GH_NO_UPDATE_NOTIFIER=1 GH_PATH=$LIVE/bin/gh
export SSL_CERT_FILE="\${SSL_CERT_FILE:-/oath/store/pkg/curl/live/ssl/cert.pem}"
exec $LIVE/libexec/gh/gh "\$@"
EOT
chmod 755 /out/bin/gh
/out/libexec/gh/gh --version | grep -q "^gh version $VERSION "
