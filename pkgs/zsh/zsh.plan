#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/zsh/
SRC=/oath/store/pkg/zsh-src/sha256-9d456902caa0000e4710383519b80b95399dd04bf685c1184a633fd2b696130e/src
FILES=/oath/store/pkg/zsh-src/sha256-9d456902caa0000e4710383519b80b95399dd04bf685c1184a633fd2b696130e/files
SOURCES='zsh-5.9.2.tar.xz'
VERSION=5.9.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/zsh/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "zsh",
    "purl": "pkg:generic/zsh@5.9.2",
    "version": "5.9.2"
  }
]
OATH_EOF
# zsh, home's login shell (R27). Its modules and functions are under this
# slot; the global startup files are /etc's, written by oath from
# host:local. No man pages or info.
tar -xf "$SRC/$SOURCES"
cd "zsh-$VERSION"
./configure --prefix="$LIVE" --enable-etcdir=/etc
make -j"$JOBS"
make install.bin install.modules install.fns DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/lib" "/tmp/dest$LIVE/share" /out/
rm -f "/out/bin/zsh-$VERSION"
# _darcs is its one GPL file, and LICENCE lets such files be left out.
rm -f "/out/share/zsh/$VERSION/functions/_darcs"
# No zsh-newuser-install menu in a new account's first shell.
rm -f "/out/share/zsh/$VERSION/scripts/newuser"
