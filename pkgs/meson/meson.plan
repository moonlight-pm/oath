#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/meson/
SRC=/oath/store/pkg/meson-src/sha256-1587be033d7ec3b6c144b2adf31faf83a71751637607851fbb91a062d6e60934/src
FILES=/oath/store/pkg/meson-src/sha256-1587be033d7ec3b6c144b2adf31faf83a71751637607851fbb91a062d6e60934/files
SOURCES='meson-1.12.1.tar.gz'
VERSION=1.12.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/meson/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "meson",
    "purl": "pkg:github/mesonbuild/meson@1.12.1",
    "version": "1.12.1"
  }
]
OATH_EOF
# Meson runs from its own tree under this slot, by the python on PATH.
tar -xf "$SRC/$SOURCES"
mkdir -p /out/bin /out/lib/meson
cp -a "meson-$VERSION/meson.py" "meson-$VERSION/mesonbuild" /out/lib/meson/
cat >/out/bin/meson <<SH
#!/bin/sh
exec python3 $LIVE/lib/meson/meson.py "\$@"
SH
chmod 755 /out/bin/meson
