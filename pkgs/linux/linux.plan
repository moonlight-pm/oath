#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/linux/
SRC=/oath/store/pkg/linux-src/sha256-808ec3c239fcf9e78c0da829f21010cb7ab33acc8504ac378a9dba337a730548/src
FILES=/oath/store/pkg/linux-src/sha256-808ec3c239fcf9e78c0da829f21010cb7ab33acc8504ac378a9dba337a730548/files
SOURCES='linux-7.3-rc1.tar.gz'
VERSION=7.3-rc1
JOBS=$(nproc)
LIVE=/oath/store/pkg/linux/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "linux",
    "purl": "pkg:generic/linux@7.3-rc1",
    "version": "7.3-rc1"
  }
]
OATH_EOF
# The one Oath kernel, built by pkg:gcc. Output: boot/vmlinuz,
# boot/config and lib/modules/<release>/ with depmod's index.
unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS CC CXX AR RANLIB NM STRIP
tar -xf "$SRC/$SOURCES"
cd linux-$VERSION
for p in "$FILES"/patches/*.patch; do
	echo "patch ${p##*/}"
	patch -p1 -i "$p"
done
# No build user, host, time or counter: the same plan gives the same image.
# The built-in initramfs takes its mtimes from the timestamp through
# `date -d`.
export TZ=UTC KBUILD_BUILD_USER=oath KBUILD_BUILD_HOST=oath KBUILD_BUILD_VERSION=1 \
	KBUILD_BUILD_TIMESTAMP='1970-01-01 00:00:00'
# Oath writes depmod's index itself, below.
k() { make ARCH=x86_64 DEPMOD=true "$@"; }
k defconfig
scripts/kconfig/merge_config.sh -m .config "$FILES/linux.fragment"
k olddefconfig
k -j"$JOBS" bzImage modules
rel=$(k -s kernelrelease)
k INSTALL_MOD_PATH=/tmp/mods INSTALL_MOD_STRIP=1 modules_install
mkdir -p /out/boot /out/lib/modules
cp arch/x86/boot/bzImage /out/boot/vmlinuz
cp .config /out/boot/config
mod=/out/lib/modules/$rel
mv "/tmp/mods/lib/modules/$rel" "$mod"
rm -f "$mod/build" "$mod/source"

# depmod's index from each module's .modinfo: modules.dep (direct needs;
# PID 1 follows them), modules.alias and modules.softdep.
cd "$mod"
awk '{ n = $0; sub(/.*\//, "", n); sub(/\.ko$/, "", n); gsub(/-/, "_", n); print n, $0 }' \
	modules.order >/tmp/names
: >modules.dep
: >modules.alias
: >modules.softdep
while read -r p; do
	n=${p##*/}
	n=$(echo "${n%.ko}" | tr - _)
	objcopy -O binary --only-section=.modinfo "$p" /tmp/modinfo
	tr '\0' '\n' </tmp/modinfo >/tmp/modinfo.txt
	needs=
	for d in $(sed -n 's/^depends=//p' /tmp/modinfo.txt | tr , ' '); do
		d=$(echo "$d" | tr - _)
		needs="$needs $(awk -v n="$d" '$1 == n { print $2 }' /tmp/names)"
	done
	echo "$p:$needs" >>modules.dep
	sed -n "s/^alias=\(.*\)/alias \1 $n/p" /tmp/modinfo.txt >>modules.alias
	sed -n "s/^softdep=\(.*\)/softdep $n \1/p" /tmp/modinfo.txt >>modules.softdep
done <modules.order
