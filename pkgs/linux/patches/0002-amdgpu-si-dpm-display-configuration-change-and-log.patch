From: Oath <oath@local>
Subject: 0002-amdgpu-si-dpm-display-configuration-change-and-log.patch

--- a/drivers/gpu/drm/amd/pm/legacy-dpm/si_dpm.c
+++ b/drivers/gpu/drm/amd/pm/legacy-dpm/si_dpm.c
@@ -23,6 +23,7 @@
 
 #include <linux/module.h>
 #include <linux/pci.h>
+#include <linux/power_supply.h>
 
 #include "amdgpu.h"
 #include "amdgpu_pm.h"
@@ -3895,10 +3896,17 @@
 	/*
 	 * Check if the platform already manages the AC/DC switch via dedicated GPIO.
 	 * Otherwise SMU automatically notices DC, but needs to be notified of AC.
+	 * Desktop boards (no ACPI AC adapter) never get an ACPI power event, so
+	 * also send RunningOnAC here when the system is on mains. Without that
+	 * the SI SMC stays on the DC boot clocks (300/150 MHz).
 	 */
-	if (adev->pm.ac_power &&
-	    (adev->pm.dpm.platform_caps & ATOM_PP_PLATFORM_CAP_HARDWAREDC))
-		amdgpu_si_send_msg_to_smc(adev, PPSMC_MSG_RunningOnAC);
+	if (adev->pm.ac_power) {
+		PPSMC_Result r = amdgpu_si_send_msg_to_smc(adev, PPSMC_MSG_RunningOnAC);
+
+		drm_info(adev_to_drm(adev),
+			 "si dpm: RunningOnAC smc=%d hardwaredc=%d\n",
+			 r, !!(adev->pm.dpm.platform_caps & ATOM_PP_PLATFORM_CAP_HARDWAREDC));
+	}
 
 	/* Recompute clocks with updated max_limits. */
 	amdgpu_legacy_dpm_compute_clocks(adev);
@@ -3929,11 +3937,27 @@
 	u32 levels = ps->performance_level_count;
 
 	if (level == AMD_DPM_FORCED_LEVEL_HIGH) {
-		if (si_send_msg_to_smc_with_parameter(adev, PPSMC_MSG_SetEnabledLevels, levels) != PPSMC_Result_OK)
-			return -EINVAL;
+		PPSMC_Result r;
 
-		if (si_send_msg_to_smc_with_parameter(adev, PPSMC_MSG_SetForcedLevels, 1) != PPSMC_Result_OK)
+		/*
+		 * Pitcairn SMC rejects SetForcedLevels(1) (0x83) after
+		 * SetEnabledLevels. rv770-era ForceHigh (0x42) is the
+		 * command that actually raises the SCLK. Try the SI
+		 * sequence first, then the older pair.
+		 */
+		r = si_send_msg_to_smc_with_parameter(adev, PPSMC_MSG_SetEnabledLevels, levels);
+		if (r == PPSMC_Result_OK)
+			r = si_send_msg_to_smc_with_parameter(adev, PPSMC_MSG_SetForcedLevels, 1);
+		if (r != PPSMC_Result_OK) {
+			amdgpu_si_send_msg_to_smc(adev, PPSMC_MSG_NoForcedLevel);
+			amdgpu_si_send_msg_to_smc(adev, PPSMC_MSG_ZeroLevelsDisabled);
+			r = amdgpu_si_send_msg_to_smc(adev, PPSMC_MSG_ForceHigh);
+		}
+		if (r != PPSMC_Result_OK) {
+			drm_err(adev_to_drm(adev),
+				"si dpm: force high failed levels=%u smc=%d\n", levels, r);
 			return -EINVAL;
+		}
 	} else if (level == AMD_DPM_FORCED_LEVEL_LOW) {
 		if (si_send_msg_to_smc_with_parameter(adev, PPSMC_MSG_SetForcedLevels, 0) != PPSMC_Result_OK)
 			return -EINVAL;
@@ -5263,8 +5287,18 @@
 		break;
 	}
 
-	if (adev->pm.dpm.platform_caps & ATOM_PP_PLATFORM_CAP_HARDWAREDC)
+	/*
+	 * VBIOS HARDWAREDC makes the SMC watch a DC GPIO. On a desktop
+	 * (no ACPI battery, ac_power) that pin floats as DC, the SMC
+	 * clamps to the 300/150 MHz DC state, and SetForcedLevels(1)
+	 * returns 0xff. Only enable the GPIO when we are actually on DC.
+	 */
+	if ((adev->pm.dpm.platform_caps & ATOM_PP_PLATFORM_CAP_HARDWAREDC) &&
+	    !adev->pm.ac_power)
 		table->systemFlags |= PPSMC_SYSTEMFLAG_GPIO_DC;
+	else if (adev->pm.dpm.platform_caps & ATOM_PP_PLATFORM_CAP_HARDWAREDC)
+		drm_info(adev_to_drm(adev),
+			 "si dpm: skip GPIO_DC (ac_power=%d)\n", adev->pm.ac_power);
 
 	if (adev->pm.dpm.platform_caps & ATOM_PP_PLATFORM_CAP_REGULATOR_HOT) {
 		if ((adev->pdev->device != 0x6818) && (adev->pdev->device != 0x6819))
@@ -7210,6 +7244,17 @@
 	si_program_display_gap(adev);
 }
 
+static int si_dpm_display_configuration_change(void *handle,
+					       const struct amd_pp_display_configuration *input)
+{
+	struct amdgpu_device *adev = handle;
+
+	if (!input)
+		return -EINVAL;
+	adev->pm.pm_display_cfg = *input;
+	return 0;
+}
+
 
 static void si_parse_pplib_non_clock_info(struct amdgpu_device *adev,
 					  struct amdgpu_ps *rps,
@@ -7712,6 +7757,14 @@
 #if 0 //TODO ?
 	si_dpm_powergate_uvd(adev, true);
 #endif
+	/* DC modeset may not have run yet, but HPD connectors exist. */
+	mutex_lock(&adev->pm.mutex);
+	adev->pm.ac_power = power_supply_is_system_supplied() > 0;
+	drm_info(adev_to_drm(adev),
+		 "si dpm late_init ac_power=%d platform_caps=0x%x\n",
+		 adev->pm.ac_power, adev->pm.dpm.platform_caps);
+	si_notify_hw_of_powersource(adev);
+	mutex_unlock(&adev->pm.mutex);
 	return 0;
 }
 
@@ -7869,6 +7922,29 @@
 		adev->pm.dpm_enabled = false;
 	else
 		adev->pm.dpm_enabled = true;
+	{
+		int i;
+
+		drm_info(adev_to_drm(adev),
+			 "si dpm hw_init enabled=%d num_ps=%d\n",
+			 adev->pm.dpm_enabled, adev->pm.dpm.num_ps);
+		for (i = 0; i < adev->pm.dpm.num_ps; i++) {
+			struct amdgpu_ps *ps = &adev->pm.dpm.ps[i];
+			struct si_ps *si_ps = si_get_ps(ps);
+			u32 sclk = 0, mclk = 0;
+
+			if (si_ps && si_ps->performance_level_count) {
+				struct rv7xx_pl *pl =
+					&si_ps->performance_levels[si_ps->performance_level_count - 1];
+
+				sclk = pl->sclk;
+				mclk = pl->mclk;
+			}
+			drm_info(adev_to_drm(adev),
+				 "si dpm ps[%d] class=0x%x sclk=%u mclk=%u\n",
+				 i, ps->class, sclk, mclk);
+		}
+	}
 	amdgpu_legacy_dpm_compute_clocks(adev);
 	mutex_unlock(&adev->pm.mutex);
 	return ret;
@@ -8154,6 +8230,7 @@
 	.set_power_state = &si_dpm_set_power_state,
 	.post_set_power_state = &si_dpm_post_set_power_state,
 	.display_configuration_changed = &si_dpm_display_configuration_changed,
+	.display_configuration_change = &si_dpm_display_configuration_change,
 	.get_sclk = &si_dpm_get_sclk,
 	.get_mclk = &si_dpm_get_mclk,
 	.print_power_state = &si_dpm_print_power_state,
