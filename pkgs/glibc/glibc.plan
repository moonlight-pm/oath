#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/glibc/
SRC=/oath/store/pkg/glibc-src/sha256-bbd0e672a1d156de29dd71ab397fc51234f0a3189dee9c0558c71506e92f7fee/src
FILES=/oath/store/pkg/glibc-src/sha256-bbd0e672a1d156de29dd71ab397fc51234f0a3189dee9c0558c71506e92f7fee/files
SOURCES='glibc-2.44.tar.xz linux-7.3.tar.xz'
VERSION=2.44
JOBS=$(nproc)
LIVE=/oath/store/pkg/glibc/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "glibc",
    "purl": "pkg:generic/glibc@2.44",
    "version": "2.44"
  }
]
OATH_EOF
# glibc and the Linux UAPI headers, built by pkg:gcc (R17). Headers in
# include/, libraries and the loader in lib/: slibdir and rtlddir are
# /lib, and there is no /lib64.
# patches/: release/2.44/master from sourceware (the 2.44 branch's fixes,
# GLIBC-SA-2026-0015 to -0024 among them), diffed from the glibc-2.44 tag.
T=x86_64-pc-linux-gnu
tar -xf "$SRC/glibc-$VERSION.tar.xz"
for p in "$FILES"/patches/*.patch; do
	patch -d "glibc-$VERSION" -p1 -s -i "$p"
done
tar -xf "$SRC/linux-7.3.tar.xz"
# The UAPI headers, as headers_install makes them but without rsync.
make -C linux-7.3 ARCH=x86_64 HOSTCC=cc headers
find linux-7.3/usr/include -type f ! -name '*.h' -delete
mkdir -p /tmp/uapi
cp -r linux-7.3/usr/include /tmp/uapi/
# glibc builds on its own terms: no other pack's headers or libraries,
# and it requires optimization.
unset CPPFLAGS LDFLAGS
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe"
mkdir build
cd build
printf 'slibdir=/lib\nrtlddir=/lib\n' >configparms
../glibc-$VERSION/configure --build=$T --host=$T --prefix= --libdir=/lib \
	--libexecdir=/lib/libexec --with-headers=/tmp/uapi/include \
	--enable-kernel=5.10 --disable-werror --disable-nscd --disable-timezone-tools \
	--enable-stack-protector=strong --enable-bind-now CXX=false \
	libc_cv_slibdir=/lib libc_cv_rtlddir=/lib
make -j"$JOBS"
make install DESTDIR=/out
cp -a /tmp/uapi/include/. /out/include/
# A loader cache of the build's own tree is no use on a machine.
rm -rf /out/etc/ld.so.cache /out/var
# ldd lists the loaders of the usual layout (/lib64/…); Oath's is /lib's.
sed -i 's|^RTLDLIST=.*|RTLDLIST="/lib/ld-linux-x86-64.so.2"|' /out/bin/ldd
grep -qx 'RTLDLIST="/lib/ld-linux-x86-64.so.2"' /out/bin/ldd
