---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/util-linux/
SRC=/oath/store/pkg/util-linux-src/sha256-14849cca97a7c9db88b11e17138dc0a7efcaf241baa825556c1a2e7a02394391/src
FILES=/oath/store/pkg/util-linux-src/sha256-14849cca97a7c9db88b11e17138dc0a7efcaf241baa825556c1a2e7a02394391/files
SOURCES='util-linux-2.42.4.tar.xz'
VERSION=2.42.4
JOBS=$(nproc)
LIVE=/oath/store/pkg/util-linux/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "util-linux",
    "purl": "pkg:generic/util-linux@2.42.4",
    "version": "2.42.4"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd util-linux-$VERSION
./configure --prefix="$LIVE" --disable-shared --enable-static \
	--disable-all-programs --enable-libuuid --enable-libblkid --enable-libfdisk \
	--enable-libsmartcols --enable-libmount --enable-fdisks=check --enable-wipefs \
	--enable-blkid --enable-lsblk \
	--disable-nls --disable-bash-completion --disable-asciidoc --disable-poman \
	--without-python --without-systemd --without-udev --without-ncurses \
	--without-ncursesw --without-tinfo --without-readline --without-libz \
	--without-btrfs --without-cap-ng --without-econf --without-selinux \
	--without-audit --without-utempter --without-user
make -j"$JOBS"
make install DESTDIR=/tmp/dest
mkdir -p /out/bin
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
for b in sfdisk wipefs blkid lsblk; do
	cp "$(find "/tmp/dest$LIVE" -name "$b" -type f | head -1)" "/out/bin/$b"
done
