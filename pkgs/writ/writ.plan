#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/writ/
SRC=/oath/store/pkg/writ-src/sha256-de142f7488907e34a075c665517971e16e61d4f58e6118227ce0ea11596c9ba3/src
FILES=/oath/store/pkg/writ-src/sha256-de142f7488907e34a075c665517971e16e61d4f58e6118227ce0ea11596c9ba3/files
SOURCES='writ'
VERSION=0.1.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/writ/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "writ",
    "purl": "pkg:generic/writ@0.1.0",
    "version": "0.1.0"
  }
]
OATH_EOF
# Output: bin/writ, static like Oath's other binaries, and components.json naming itself.
# Its box needs a user namespace, which the sandbox blocks: `writ check` tests that on a machine.
export HOME=/tmp/home CARGO_HOME=/tmp/cargo RUSTFLAGS="-C target-feature=+crt-static"
target=x86_64-unknown-linux-gnu
mkdir -p "$HOME" /out/bin
cp -a "$SRC/writ" /tmp/writ
cd /tmp/writ
cargo test --frozen --target $target
cargo build --release --frozen --target $target
cp target/$target/release/writ /out/bin/writ
if readelf -lW /out/bin/writ | grep -q INTERP; then
	echo "/out/bin/writ is dynamically linked; Oath's binaries are static" >&2
	exit 1
fi
cat >/out/components.json <<JSON
{
  "components": [
    {
      "name": "writ",
      "purl": "pkg:generic/writ@$VERSION",
      "version": "$VERSION"
    }
  ]
}
JSON
/out/bin/writ --help | grep -q 'writ check'
