---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/dropbear/
SRC=/oath/store/pkg/dropbear-src/sha256-1e86cafc752dbc0647bb8852b4d6a9550676ff919d57ac86105233bfaf6b3d70/src
FILES=/oath/store/pkg/dropbear-src/sha256-1e86cafc752dbc0647bb8852b4d6a9550676ff919d57ac86105233bfaf6b3d70/files
SOURCES='dropbear-2026.94.tar.bz2'
VERSION=2026.94
JOBS=$(nproc)
LIVE=/oath/store/pkg/dropbear/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "dropbear",
    "purl": "pkg:generic/dropbear@2026.94",
    "version": "2026.94"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd dropbear-$VERSION
cp "$FILES/localoptions.h" .
./configure --prefix=/ --enable-static --disable-lastlog --disable-utmp \
	--disable-utmpx --disable-wtmp --disable-wtmpx --disable-pututline \
	--disable-pututxline
make -j"$JOBS" PROGRAMS="dropbear dropbearkey"
mkdir -p /out/bin
cp dropbear dropbearkey /out/bin/
