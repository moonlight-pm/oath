---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/cmake/
SRC=/oath/store/pkg/cmake-src/sha256-d17c2788f021d155a00d9d521437c88dc75882d7c5c68296648d9b626df7659e/src
FILES=/oath/store/pkg/cmake-src/sha256-d17c2788f021d155a00d9d521437c88dc75882d7c5c68296648d9b626df7659e/files
SOURCES='cmake-4.4.4.tar.gz'
VERSION=4.4.4
JOBS=$(nproc)
LIVE=/oath/store/pkg/cmake/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "cmake",
    "purl": "pkg:github/Kitware/CMake@v4.4.4",
    "version": "4.4.4"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd cmake-$VERSION
# libarchive looks for iconv.h with find_path, which does not know the
# compiler's sysroot (musl has iconv in libc).
sysinc=$(cd "$(cc -print-resource-dir)/../../../sysroot/include" && pwd)
# The bundled curl has no TLS: nothing downloads inside a sandbox. No
# curses or Qt front end.
./bootstrap --prefix=/ --parallel="$JOBS" --no-system-libs --no-qt-gui -- \
	-DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
	-DBUILD_CursesDialog=OFF -DCMAKE_USE_OPENSSL=OFF \
	-DICONV_INCLUDE_DIR="$sysinc"
make -j"$JOBS"
make install DESTDIR=/out
rm -rf /out/doc /out/share/man /out/share/aclocal /out/share/bash-completion \
	/out/share/emacs /out/share/vim
