#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/iproute2/
SRC=/oath/store/pkg/iproute2-src/sha256-b26c27d36c783c5cbf562ca8f085ae63c6fda61b48c28f0d450368403d162e89/src
FILES=/oath/store/pkg/iproute2-src/sha256-b26c27d36c783c5cbf562ca8f085ae63c6fda61b48c28f0d450368403d162e89/files
SOURCES='iproute2-7.2.0.tar.xz'
VERSION=7.2.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/iproute2/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "iproute2",
    "purl": "pkg:generic/iproute2@7.2.0",
    "version": "7.2.0"
  }
]
OATH_EOF
# iproute2: ip, ss, bridge, tc. No arpd (it needs Berkeley DB).
tar -xf "$SRC/$SOURCES"
cd "iproute2-$VERSION"
sed -i /ARPD/d Makefile
m() { make PREFIX="$LIVE" SBINDIR="$LIVE/bin" NETNS_RUN_DIR=/run/netns "$@"; }
./configure
m -j"$JOBS"
m install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/bin" /out/
[ -d "/tmp/dest$LIVE/share/iproute2" ] && mkdir -p /out/share &&
	cp -a "/tmp/dest$LIVE/share/iproute2" /out/share/
[ -d "/tmp/dest$LIVE/lib" ] && cp -a "/tmp/dest$LIVE/lib" /out/
true
