---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/curl/
SRC=/oath/store/pkg/curl-src/sha256-f4d4a4ac09d9e1bf2cf0f02aa722a7d149944254e3168d53a02803c6e9550fc0/src
FILES=/oath/store/pkg/curl-src/sha256-f4d4a4ac09d9e1bf2cf0f02aa722a7d149944254e3168d53a02803c6e9550fc0/files
SOURCES='curl-8.23.0.tar.xz cacert-2026-09-25.pem'
VERSION=8.23.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/curl/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "curl",
    "purl": "pkg:generic/curl@8.23.0",
    "version": "8.23.0"
  }
]
OATH_EOF
tar -xf "$SRC/curl-$VERSION.tar.xz"
cd curl-$VERSION
./configure --prefix=/ --disable-shared --enable-static \
	--with-mbedtls=/oath/store/pkg/mbedtls/live --with-zlib=/oath/store/pkg/zlib/live \
	--with-ca-bundle="$LIVE/ssl/cert.pem" --without-ca-path \
	--without-libpsl --without-libidn2 --without-nghttp2 --without-brotli \
	--without-zstd --without-libssh2 --disable-ldap --disable-ldaps \
	--disable-rtsp --disable-dict --disable-telnet --disable-tftp \
	--disable-pop3 --disable-imap --disable-smtp --disable-gopher \
	--disable-mqtt --disable-manual --disable-docs
make -j"$JOBS"
mkdir -p /out/bin /out/ssl
cp src/curl /out/bin/curl
cp "$SRC"/cacert-*.pem /out/ssl/cert.pem
