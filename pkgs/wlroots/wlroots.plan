---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/wlroots/
SRC=/oath/store/pkg/wlroots-src/sha256-67452148aff81e571bce0cddc0e417553c75b214eb88f064982471e4d380c132/src
FILES=/oath/store/pkg/wlroots-src/sha256-67452148aff81e571bce0cddc0e417553c75b214eb88f064982471e4d380c132/files
SOURCES='wlroots-0.20.2.tar.gz'
VERSION=0.20.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/wlroots/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "wlroots",
    "purl": "pkg:generic/wlroots@0.20.2",
    "version": "0.20.2"
  }
]
OATH_EOF
# wlroots, shared, with Oath's patches: the DRM and libinput backends
# (session through libseat, devices through libudev-zero), the GLES2
# renderer, GBM buffers and Xwayland, whose path it compiles in.
tar -xf "$SRC/$SOURCES"
cd "wlroots-$VERSION"
for p in "$FILES"/patches/*.patch; do
	echo "patch ${p##*/}"
	patch -p1 -i "$p"
done
meson setup build --prefix="$LIVE" --libdir=lib --buildtype=release -Dwerror=false \
	-Dexamples=false -Dbackends=drm,libinput -Drenderers=gles2 -Dallocators=gbm \
	-Dsession=enabled -Dxwayland=enabled -Dxcb-errors=enabled -Dlibliftoff=disabled \
	-Dcolor-management=disabled
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/include" "/tmp/dest$LIVE/lib" /out/
