#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/nss/
SRC=/oath/store/pkg/nss-src/sha256-214e997a73569208de5b72d32cd51259b0aa6471d34103d910e5b1e39d9a0c27/src
FILES=/oath/store/pkg/nss-src/sha256-214e997a73569208de5b72d32cd51259b0aa6471d34103d910e5b1e39d9a0c27/files
SOURCES='nss-3.131.tar.gz'
VERSION=3.131
JOBS=$(nproc)
LIVE=/oath/store/pkg/nss/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "nss",
    "purl": "pkg:generic/nss@3.131",
    "version": "3.131"
  }
]
OATH_EOF
# NSS's libraries (libnss3 opens softokn, freebl and nssckbi beside
# itself, with their .chk files), headers and nss.pc. NSS has no install
# target; its object directory is named after the host, so it is found
# by pattern. Serial: coreconf's recursive make. coreconf ignores
# CFLAGS; XCFLAGS carries the include paths (zlib).
tar -xf "$SRC/$SOURCES"
cd "nss-$VERSION/nss"
nspr=/oath/store/pkg/nspr/live
make all BUILD_OPT=1 USE_64=1 NSPR_INCLUDE_DIR="$nspr/include/nspr" NSPR_LIB_DIR="$nspr/lib" \
	USE_SYSTEM_ZLIB=1 ZLIB_LIBS=-lz NSS_DISABLE_GTESTS=1 NSS_ENABLE_WERROR=0 CC=cc CCC=c++ \
	XCFLAGS="$CPPFLAGS"
obj=$(echo ../dist/Linux*_x86_64_cc_glibc_PTH_64_OPT.OBJ)
mkdir -p /out/lib/pkgconfig /out/include/nss
cp "$obj"/lib/*.so "$obj"/lib/*.chk /out/lib/
cp -RL ../dist/public/nss/. /out/include/nss/
nspr_version=$(sed -n 's/^Version: //p' "$nspr/lib/pkgconfig/nspr.pc")
sed -e "s|%prefix%|$LIVE|" -e "s|%exec_prefix%|$LIVE|" -e "s|%libdir%|$LIVE/lib|" \
	-e "s|%includedir%|$LIVE/include/nss|" -e "s|%NSS_VERSION%|$VERSION|" \
	-e "s|%NSPR_VERSION%|$nspr_version|" pkg/pkg-config/nss.pc.in >/out/lib/pkgconfig/nss.pc
