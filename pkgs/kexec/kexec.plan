---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/kexec/
SRC=/oath/store/pkg/kexec-src/sha256-6c37cd8dbdc552b6be4a28d2f24e6a864520ae94fd83b076d003ac4f1afe04a6/src
FILES=/oath/store/pkg/kexec-src/sha256-6c37cd8dbdc552b6be4a28d2f24e6a864520ae94fd83b076d003ac4f1afe04a6/files
SOURCES='kexec-tools-2.0.32.tar.xz'
VERSION=2.0.32
JOBS=$(nproc)
LIVE=/oath/store/pkg/kexec/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "kexec",
    "purl": "pkg:generic/kexec-tools@2.0.32",
    "version": "2.0.32"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd kexec-tools-$VERSION
# No separate assembler: clang assembles .S itself.
mkdir -p /tmp/bin
printf '#!/bin/sh\nexec cc -c "$@"\n' > /tmp/bin/as
chmod +x /tmp/bin/as
PATH=/tmp/bin:$PATH
./configure --prefix=/ --without-lzma --without-xen AS=as
make -j"$JOBS"
mkdir -p /out/bin
cp build/sbin/kexec /out/bin/kexec
