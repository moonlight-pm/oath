#!oath-plan
{
  "name": "pkgconf",
  "produces": "pkg:pkgconf",
  "build_needs": [
    {
      "id": "pkg:busybox",
      "hash": "sha256-5c07428c094578850fa4fbf5ab3eb123d4d563178885cb4b32fae5deaa951d35"
    },
    {
      "id": "pkg:llvm",
      "hash": "sha256-1a5d6cad24b01b2dcef476d260fb3a108471708948d661767e249d2653ed65ea"
    },
    {
      "id": "pkg:make",
      "hash": "sha256-ade99e47287653412c2bfabcf7495c787598975dbe6155109cba2c81ae1431cf"
    },
    {
      "id": "pkg:pkgconf-src",
      "hash": "sha256-e66af29981cdaadf9ccbed2d204252b65edfa923585ebb8ae67f617ec01704fc"
    }
  ],
  "run_needs": []
}
---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/pkgconf/
SRC=/oath/store/pkg/pkgconf-src/sha256-e66af29981cdaadf9ccbed2d204252b65edfa923585ebb8ae67f617ec01704fc/src
FILES=/oath/store/pkg/pkgconf-src/sha256-e66af29981cdaadf9ccbed2d204252b65edfa923585ebb8ae67f617ec01704fc/files
SOURCES='pkgconf-3.0.8.tar.xz'
VERSION=3.0.8
JOBS=$(nproc)
LIVE=/oath/store/pkg/pkgconf/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "pkgconf",
    "purl": "pkg:generic/pkgconf@3.0.8",
    "version": "3.0.8"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd pkgconf-$VERSION
./configure --prefix=/ --disable-shared --enable-static
make -j"$JOBS"
mkdir -p /out/bin
cp pkgconf /out/bin/pkgconf
ln -s pkgconf /out/bin/pkg-config
