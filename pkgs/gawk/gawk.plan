#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/gawk/
SRC=/oath/store/pkg/gawk-src/sha256-b18964120f63393b2e24d05b11e16846da5ee5041f0e513047e4acf1cf14270c/src
FILES=/oath/store/pkg/gawk-src/sha256-b18964120f63393b2e24d05b11e16846da5ee5041f0e513047e4acf1cf14270c/files
SOURCES='gawk-5.4.1.tar.xz'
VERSION=5.4.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/gawk/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "gawk",
    "purl": "pkg:generic/gawk@5.4.1",
    "version": "5.4.1"
  }
]
OATH_EOF
# GNU awk, with MPFR (gawk 5.4.1 without it miscompiles the awk scripts
# that generate GCC 16.2's option tables). Its extensions are in lib/gawk
# and its awk library in share/awk.
tar -xf "$SRC/$SOURCES"
cd "gawk-$VERSION"
sed -i 's/extras//' Makefile.in
./configure --prefix="$LIVE" --disable-nls
make -j"$JOBS"
./gawk --version | grep -q 'GNU MPFR' || { echo "gawk was built without MPFR" >&2; exit 1; }
make install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/lib" "/tmp/dest$LIVE/libexec" /out/
mkdir -p /out/share
cp -a "/tmp/dest$LIVE/share/awk" /out/share/
