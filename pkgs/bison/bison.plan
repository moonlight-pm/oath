#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/bison/
SRC=/oath/store/pkg/bison-src/sha256-ac0f2b44584259e10ca18287e16e14eba1b37edf71426707b737814c6d83e46f/src
FILES=/oath/store/pkg/bison-src/sha256-ac0f2b44584259e10ca18287e16e14eba1b37edf71426707b737814c6d83e46f/files
SOURCES='bison-3.8.2.tar.xz'
VERSION=3.8.2
JOBS=$(nproc)
LIVE=/oath/store/pkg/bison/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "bison",
    "purl": "pkg:generic/bison@3.8.2",
    "version": "3.8.2"
  }
]
OATH_EOF
# Bison reads its skeletons from share/bison under the slot path and runs
# m4 from PATH (the path configure found).
tar -xf "$SRC/$SOURCES"
cd bison-$VERSION
./configure --prefix="$LIVE" --disable-nls
make -j"$JOBS"
make install DESTDIR=/tmp/dest
mkdir -p /out/share
cp -a "/tmp/dest$LIVE/bin" /out/
cp -a "/tmp/dest$LIVE/share/bison" /out/share/
