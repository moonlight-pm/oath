#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/btrfs/
SRC=/oath/store/pkg/btrfs-src/sha256-085278760e39e25e369dc382cf3fae578e626cb6f98b32a344f3afeb986e6502/src
FILES=/oath/store/pkg/btrfs-src/sha256-085278760e39e25e369dc382cf3fae578e626cb6f98b32a344f3afeb986e6502/files
SOURCES='btrfs-progs-v7.1.tar.xz'
VERSION=7.1
JOBS=$(nproc)
LIVE=/oath/store/pkg/btrfs/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "btrfs",
    "purl": "pkg:generic/btrfs-progs@7.1",
    "version": "7.1"
  }
]
OATH_EOF
tar -xf "$SRC/$SOURCES"
cd btrfs-progs-v$VERSION
./configure --prefix=/ --disable-documentation --disable-python --disable-convert \
	--disable-libudev --disable-shared --disable-zoned --disable-backtrace
make -j"$JOBS" btrfs mkfs.btrfs
mkdir -p /out/bin
cp btrfs mkfs.btrfs /out/bin/
