#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/xkeyboard-config/
SRC=/oath/store/pkg/xkeyboard-config-src/sha256-762eab28a3a303b42309b9afa78eb544c699a9f92222fcb4c59cbaa9833e4d0d/src
FILES=/oath/store/pkg/xkeyboard-config-src/sha256-762eab28a3a303b42309b9afa78eb544c699a9f92222fcb4c59cbaa9833e4d0d/files
SOURCES='xkeyboard-config-2.48.tar.xz'
VERSION=2.48
JOBS=$(nproc)
LIVE=/oath/store/pkg/xkeyboard-config/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "xkeyboard-config",
    "purl": "pkg:generic/xkeyboard-config@2.48",
    "version": "2.48"
  }
]
OATH_EOF
# Data only: share/xkeyboard-config-2, with share/X11/xkb linking to it.
# Its .pc goes to lib/pkgconfig, where the sandbox looks. No NLS. The
# sandbox has no /usr/bin/env, and meson runs a perl script by its
# #! line, so that line names perl's path.
tar -xf "$SRC/$SOURCES"
cd "xkeyboard-config-$VERSION"
sed -i "1s|^#!/usr/bin/env perl|#!$(command -v perl)|" rules/xml2lst.pl
meson setup build --prefix="$LIVE" --buildtype=release -Dnls=false
ninja -C build -j"$JOBS"
DESTDIR=/tmp/dest ninja -C build install
cp -a "/tmp/dest$LIVE/share" /out/
mkdir -p /out/lib
mv /out/share/pkgconfig /out/lib/pkgconfig
rm -rf /out/share/man
