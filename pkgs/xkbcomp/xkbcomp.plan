#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/xkbcomp/
SRC=/oath/store/pkg/xkbcomp-src/sha256-1d77ce3570574ee76e3fecac6d9a3b6a2973893c17bac09e2ef29cda0dcc87f6/src
FILES=/oath/store/pkg/xkbcomp-src/sha256-1d77ce3570574ee76e3fecac6d9a3b6a2973893c17bac09e2ef29cda0dcc87f6/files
SOURCES='xkbcomp-1.5.0.tar.xz'
VERSION=1.5.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/xkbcomp/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "xkbcomp",
    "purl": "pkg:generic/xkbcomp@1.5.0",
    "version": "1.5.0"
  }
]
OATH_EOF
# xkbcomp, reading xkeyboard-config's slot by default.
tar -xf "$SRC/$SOURCES"
cd "xkbcomp-$VERSION"
./configure --prefix="$LIVE" --with-xkb-config-root=/oath/store/pkg/xkeyboard-config/live/share/X11/xkb
make -j"$JOBS"
make install DESTDIR=/tmp/dest
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/lib" /out/
