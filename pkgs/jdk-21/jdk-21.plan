#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/jdk-21/
SRC=/oath/store/pkg/jdk-21-src/sha256-636abee6fa0a8f5fe7413e6c53fa9822303aeb0460bddd06b52b0659bb1c25c9/src
FILES=/oath/store/pkg/jdk-21-src/sha256-636abee6fa0a8f5fe7413e6c53fa9822303aeb0460bddd06b52b0659bb1c25c9/files
SOURCES='OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz'
VERSION=21.0.13+9
JOBS=$(nproc)
LIVE=/oath/store/pkg/jdk-21/live
LIBDIR=lib
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */gcc/live | */glibc/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "jdk-21",
    "purl": "pkg:generic/temurin-jdk@21.0.13%2B9",
    "version": "21.0.13+9"
  }
]
OATH_EOF
# Output: libexec/jdk-21/, Temurin's tree as it ships, without its source
# archive (lib/src.zip) and debug-symbol archives. Its programs are pointed
# at /lib's loader, and lib/libjvm.so names lib/server's, as in pkg:jre-21.
tar -xzf "$SRC/$SOURCES" --no-same-owner
d=/out/libexec/jdk-21
mkdir -p /out/libexec
mv "jdk-$VERSION" "$d"
grep -qx "JAVA_RUNTIME_VERSION=\"$VERSION-LTS\"" "$d/release"
rm -f "$d/lib/src.zip"
find "$d" -name '*.debuginfo' -delete
for f in "$d"/bin/* "$d"/lib/jexec "$d"/lib/jspawnhelper; do
	patchelf --set-interpreter /lib/ld-linux-x86-64.so.2 "$f"
done
ln -s server/libjvm.so "$d/lib/libjvm.so"

# It compiles and runs a class.
mkdir /tmp/t
printf '%s\n' 'public class T { public static void main(String[] a) {' \
	'System.out.println("ok"); } }' >/tmp/t/T.java
"$d/bin/javac" -d /tmp/t /tmp/t/T.java
[ "$("$d/bin/java" -cp /tmp/t T)" = ok ]
