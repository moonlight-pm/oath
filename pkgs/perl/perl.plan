#!oath-plan
{
  "name": "perl",
  "produces": "pkg:perl",
  "build_needs": [
    {
      "id": "pkg:busybox",
      "hash": "sha256-5c07428c094578850fa4fbf5ab3eb123d4d563178885cb4b32fae5deaa951d35"
    },
    {
      "id": "pkg:llvm",
      "hash": "sha256-1a5d6cad24b01b2dcef476d260fb3a108471708948d661767e249d2653ed65ea"
    },
    {
      "id": "pkg:make",
      "hash": "sha256-ade99e47287653412c2bfabcf7495c787598975dbe6155109cba2c81ae1431cf"
    },
    {
      "id": "pkg:perl-src",
      "hash": "sha256-6d21fe34ef7612cab16c82c4dcc4f1cf1fcd4c1ba4d39c2e0df291e884a2bdb0"
    }
  ],
  "run_needs": []
}
---
#!/bin/sh
set -eu
# generated by cargo make pkgs from pkgs/perl/
SRC=/oath/store/pkg/perl-src/sha256-6d21fe34ef7612cab16c82c4dcc4f1cf1fcd4c1ba4d39c2e0df291e884a2bdb0/src
FILES=/oath/store/pkg/perl-src/sha256-6d21fe34ef7612cab16c82c4dcc4f1cf1fcd4c1ba4d39c2e0df291e884a2bdb0/files
SOURCES='perl-5.44.0.tar.xz'
VERSION=5.44.0
JOBS=$(nproc)
LIVE=/oath/store/pkg/perl/live
export CC=cc CXX=c++ AR=ar RANLIB=ranlib NM=nm STRIP=strip
export CFLAGS="-O2 -pipe" CXXFLAGS="-O2 -pipe" SOURCE_DATE_EPOCH=0
CPPFLAGS= LDFLAGS= PKG_CONFIG_PATH=
for d in /oath/store/pkg/*/live; do
	case $d in */llvm/live | *-src/live) continue ;; esac
	[ -d "$d/include" ] && CPPFLAGS="$CPPFLAGS -I$d/include"
	[ -d "$d/lib" ] && LDFLAGS="$LDFLAGS -L$d/lib"
	[ -d "$d/lib/pkgconfig" ] && PKG_CONFIG_PATH="$d/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
done
export CPPFLAGS LDFLAGS PKG_CONFIG_PATH
# Hand-written Makefiles often ignore CPPFLAGS.
CFLAGS="$CFLAGS $CPPFLAGS" CXXFLAGS="$CXXFLAGS $CPPFLAGS"
mkdir -p /out
cat > /out/components.json <<'OATH_EOF'
[
  {
    "name": "perl",
    "purl": "pkg:generic/perl@5.44.0",
    "version": "5.44.0"
  }
]
OATH_EOF
# One static perl: no dynamic loading, so every core XS module is linked
# in. It finds its library under the slot path. Configure records who,
# where and when it ran; those are fixed so the same plan gives the
# same product. musl declares eaccess() only for _GNU_SOURCE, which perl
# does not define, so perl uses its own.
tar -xf "$SRC/$SOURCES"
cd perl-$VERSION
sh Configure -des -Dprefix="$LIVE" -Dcc=cc -Dld=cc -Dar=ar -Dnm=nm \
	-Doptimize=-O2 -Uusedl -Dusenm=false -Ud_eaccess \
	-Dman1dir=none -Dman3dir=none \
	-Dcf_by=oath -Dcf_email=oath@oath -Dperladmin=oath@oath \
	-Dmyhostname=oath -Dmydomain=.oath -Dmyuname=oath -Dosvers=oath
# Configure always records the time it ran; set it in config.sh and
# regenerate what reads it (config.h, Config, perlbug).
t='Thu Jan  1 00:00:00 UTC 1970'
sed -i -e "s/^cf_time=.*/cf_time='$t'/" \
	-e "s/^# Configuration time: .*/# Configuration time: $t/" config.sh
sh Configure -S
make -j"$JOBS"
make install DESTDIR=/tmp/dest
# Config records the compiler's search paths (for building XS modules):
# name them by the compiler's slot, not its hash, so this product does
# not change with every pkg:llvm.
for f in "/tmp/dest$LIVE"/lib/*/*/Config.pm "/tmp/dest$LIVE"/lib/*/*/Config_heavy.pl; do
	sed -i 's|/oath/store/pkg/llvm/sha256-[0-9a-f]*/|/oath/store/pkg/llvm/live/|g' "$f"
done
cp -a "/tmp/dest$LIVE/bin" "/tmp/dest$LIVE/lib" /out/
