#!/bin/sh
# Send a read-only generation of @ to one NFS file. Overwrite atomically.
# Usage: backup-send host:/export/path
# Writes $hostname.send and $hostname.json in that directory.
set -eu

spec=${1:?nfs spec (host:/path)}

host=$(hostname 2>/dev/null || echo oath)
host=${host%%.*}
[ -n "$host" ] || host=oath

fs=/oath/run/fs
live=$fs/@
mnt=/run/oath-backup
# Status is on the /oath/status tmpfs; this service's own record of its
# last run lives with its log, so it survives a reboot (R14).
status=/oath/status/svc/backup.json
last=/oath/log/svc/backup.last.json
mounted=0

log() { echo "backup-send: $*" >&2; }

die() {
	log "error: $*"
	exit 1
}

quiesced_list=/tmp/oath-backup-quiesced

thaw_all() {
	[ -f "$quiesced_list" ] || return 0
	# Reverse of quiesce order.
	names=$(cat "$quiesced_list")
	rev=
	for n in $names; do
		rev="$n $rev"
	done
	for name in $rev; do
		hook=/oath/store/pkg/$name/live/libexec/oath-backup-thaw
		[ -x "$hook" ] || hook=/oath/store/pkg/$name/libexec/oath-backup-thaw
		if [ -x "$hook" ]; then
			log "thaw pkg:$name"
			"$hook" || log "thaw pkg:$name failed (continuing)"
		fi
	done
	rm -f "$quiesced_list"
}

cleanup() {
	thaw_all
	if [ "$mounted" = 1 ]; then
		umount "$mnt" 2>/dev/null || umount -l "$mnt" 2>/dev/null || true
		mounted=0
	fi
}
trap cleanup EXIT

have_fs() {
	grep -q "$1" /proc/filesystems 2>/dev/null
}

load_nfs() {
	have_fs nfs && have_fs nfs4 && return 0
	# PID 1's modprobe helper loads each module after what it needs.
	/lib/oath/modprobe -q -- nfsv4 nfsv3 || true
	have_fs nfs || have_fs nfs4 || die "nfs filesystem not available"
}

next_gen() {
	n=0
	for d in "$fs"/@gen-*; do
		[ -d "$d" ] || continue
		b=${d##*/}
		g=${b#@gen-}
		case $g in
		'' | *[!0-9]*) continue ;;
		esac
		[ "$g" -gt "$n" ] && n=$g
	done
	echo $((n + 1))
}

pkg_present() {
	f=/oath/status/pkg/$1.json
	[ -f "$f" ] || return 1
	grep -q '"present"[[:space:]]*:[[:space:]]*true' "$f"
}

quiesce_all() {
	rm -f "$quiesced_list"
	touch "$quiesced_list"
	for dir in $(ls /oath/objects/pkg 2>/dev/null | sort); do
		pkg_present "$dir" || continue
		hook=/oath/store/pkg/$dir/live/libexec/oath-backup-quiesce
		[ -x "$hook" ] || hook=/oath/store/pkg/$dir/libexec/oath-backup-quiesce
		[ -x "$hook" ] || continue
		log "quiesce pkg:$dir"
		if ! "$hook"; then
			die "quiesce pkg:$dir failed"
		fi
		echo "$dir" >>"$quiesced_list"
	done
}

current_gen() {
	p=/oath/objects/snap/current/applied.json
	[ -f "$p" ] || p=/oath/objects/snap/current/desired.json
	[ -f "$p" ] || {
		echo 0
		return
	}
	# {"generation": 14}
	sed -n 's/.*"generation"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$p" | head -n 1
}

load_nfs
mkdir -p "$mnt"
# There is no mount.nfs (-i): the kernel parses the options itself and
# needs the server's address in them.
server=${spec%%:*}
addr=$(getent ahostsv4 "$server" | awk 'NR == 1 { print $1 }')
[ -n "$addr" ] || die "cannot resolve $server"
opts=rw,nolock,soft,timeo=30,addr=$addr
log "mount $spec ($addr) -> $mnt"
if have_fs nfs4; then
	mount -i -t nfs4 -o "$opts" "$spec" "$mnt" || die "mount nfs4 $spec"
else
	mount -i -t nfs -o "$opts,vers=4" "$spec" "$mnt" ||
		mount -i -t nfs -o "$opts,vers=3" "$spec" "$mnt" ||
		die "mount nfs $spec"
fi
mounted=1
log "mounted"

[ -d "$live" ] || die "no live subvol $live"
quiesce_all
sync
btrfs filesystem sync "$live" 2>/dev/null || true
parent=$(current_gen)
[ -n "$parent" ] || parent=0
gen=$(next_gen)
snap=$fs/@gen-$gen
log "snapshot @ -> @gen-$gen (parent $parent)"
btrfs subvolume snapshot -r "$live" "$snap" || die "snapshot"
thaw_all

now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
snapdir=/oath/objects/snap/$gen
mkdir -p "$snapdir" /oath/status/snap
# The generation record is history: it is snap:N's spec.
printf '{"generation":%s,"parent":%s,"time":"%s","reason":"backup"}\n' "$gen" "$parent" "$now" >"$snapdir/desired.json"
printf '{"id":"snap:%s","kind":"snap","name":"%s","safety":"mutate","status":"in-sync"}\n' "$gen" "$gen" >"$snapdir/meta.json"
printf '{"generation":%s}\n' "$gen" >/oath/objects/snap/current/desired.json
printf '{"generation":%s}\n' "$gen" >/oath/objects/snap/current/applied.json
printf '{"generation":%s}\n' "$gen" >/oath/status/snap/current.json

tmp=$mnt/$host.send.tmp
final=$mnt/$host.send
side_tmp=$mnt/$host.json.tmp
side=$mnt/$host.json
rm -f "$tmp" "$side_tmp"
log "send $snap -> $spec $host.send.tmp"
btrfs send -f "$tmp" "$snap" || {
	rm -f "$tmp"
	die "btrfs send"
}
sync
size=$(wc -c <"$tmp")
size=$(echo "$size" | tr -d ' ')
sum=$(sha256sum "$tmp")
sum=${sum%% *}
printf '{"hostname":"%s","generation":%s,"time":"%s","size":%s,"checksum":"sha256:%s","dest":"%s"}\n' \
	"$host" "$gen" "$now" "$size" "$sum" "$spec" >"$side_tmp"
sync
mv -f "$tmp" "$final"
mv -f "$side_tmp" "$side"
sync
log "ok generation=$gen size=$size checksum=sha256:$sum"

mkdir -p "${last%/*}"
printf '{"generation":%s,"time":"%s","dest":"%s","checksum":"sha256:%s","size":%s}\n' \
	"$gen" "$now" "$spec" "$sum" "$size" >"$last"
if [ -f "$status" ]; then
	printf '{"state":"running","pid":null,"restarts":0,"generation":%s,"time":"%s","dest":"%s","checksum":"sha256:%s","size":%s}\n' \
		"$gen" "$now" "$spec" "$sum" "$size" >"$status"
fi

log "done"
exit 0
