#!/bin/sh
# Run backup-send every day at 04:00 local time.
# Usage: backup-daily host:/export/path
# Local time is TZ, which PID 1 sets from host:local.timezone (POSIX TZ,
# no tzdata). With no timezone set, 04:00 is UTC.
set -eu

spec=${1:?nfs spec (host:/path)}
send=/lib/oath/backup-send
if [ ! -x "$send" ]; then
	echo "backup-daily: missing $send" >&2
	exit 1
fi

export TZ="${TZ:-UTC0}"

log() { echo "backup-daily: $*" >&2; }

# The next 04:00, local time, as seconds since the epoch.
next_four() {
	t=$(date -d 'today 04:00' +%s)
	[ "$(date +%s)" -lt "$t" ] || t=$(date -d 'tomorrow 04:00' +%s)
	echo "$t"
}

# A minute at a time against the clock: sleep(1) counts no time the
# machine spends asleep (R84), so one long sleep would run late.
sleep_until_four() {
	target=$(next_four)
	log "sleep until 04:00 local time ($(date -d "@$target"))"
	while [ "$(date +%s)" -lt "$target" ]; do
		sleep 60
	done
}

log "start dest=$spec tz=$TZ now=$(date)"
while :; do
	sleep_until_four
	log "run $send $spec"
	if "$send" "$spec"; then
		log "send ok"
	else
		log "send failed (will try again tomorrow)"
	fi
done
