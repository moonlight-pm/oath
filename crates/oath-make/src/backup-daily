#!/bin/sh
# Run backup-send every day at 04:00 local time.
# Usage: backup-daily host:/export/path
# Local time is TZ, which PID 1 sets from host:local.timezone (POSIX TZ,
# no tzdata). With no timezone set, 04:00 is UTC.
set -eu

spec=${1:?nfs spec (host:/path)}
send=/lib/oath/backup-send
if [ ! -x "$send" ]; then
	echo "backup-daily: missing $send" >&2
	exit 1
fi

export TZ="${TZ:-UTC0}"

log() { echo "backup-daily: $*" >&2; }

unpad() {
	n=$1
	while [ -n "$n" ] && [ "$n" != "${n#0}" ] && [ ${#n} -gt 1 ]; do
		n=${n#0}
	done
	[ -n "$n" ] || n=0
	echo "$n"
}

seconds_since_midnight() {
	h=$(unpad "$(date +%H)")
	m=$(unpad "$(date +%M)")
	s=$(unpad "$(date +%S)")
	echo $((h * 3600 + m * 60 + s))
}

sleep_until_four() {
	now=$(seconds_since_midnight)
	target=$((4 * 3600))
	if [ "$now" -ge "$target" ]; then
		wait=$((86400 - now + target))
	else
		wait=$((target - now))
	fi
	log "sleep ${wait}s until 04:00 Mountain ($(date))"
	sleep "$wait"
}

log "start dest=$spec tz=$TZ now=$(date)"
while :; do
	sleep_until_four
	log "run $send $spec"
	if "$send" "$spec"; then
		log "send ok"
	else
		log "send failed (will try again tomorrow)"
	fi
done
