    "svc:dbus-session": {
      "exec": [
        "/bin/dbus-daemon",
        "--session",
        "--nofork",
        "--nopidfile",
        "--address=unix:path=/run/user/1/bus"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true,
      "user": "home"
    },
    "svc:sola-kvm": {
      "exec": [
        "/bin/sola-kvm",
        "listen",
        "--bind",
        "0.0.0.0:4242"
      ],
      "wants": [
        "svc:sola-river"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
