      "exec": [
        "/bin/tmux",
        "-L",
        "sola-ws",
        "-f",
        "/home/.config/sola/tmux.conf",
        "-D"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/zsh"
      }
    },
    "svc:sola-session": {
      "exec": [
        "/bin/sola-session"
      ],
      "wants": [
        "svc:sola-bus",
        "svc:sola-call",
        "svc:sola-tmux",
        "svc:sola-tmux-ws"
