    "svc:screen": {
      "enabled": false
    },
    "svc:seatd": {
      "exec": [
        "/bin/seatd",
        "-u",
        "home",
        "-g",
        "home"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true
    },
    "svc:rivulet": {
      "exec": [
        "/bin/rivulet",
        "-log-level",
        "info",
        "-c",
        ":"
      ],
      "wants": [
        "svc:seatd"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "LIBSEAT_BACKEND": "seatd",
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave"
      }
    },
    "svc:sola-bus": {
      "exec": [
        "/bin/sola-bus"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/zsh"
      }
    },
    "svc:sola-call": {
      "exec": [
        "/bin/sola-call"
      ],
      "wants": [
        "svc:sola-bus"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/zsh"
      }
    },
    "svc:sola-river": {
      "exec": [
        "/bin/sola-river"
      ],
      "wants": [
        "svc:rivulet",
        "svc:sola-bus",
        "svc:sola-call"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/zsh"
      }
    },
    "svc:sola-shell": {
      "exec": [
        "/bin/sola-shell"
