{
  "extends": "base",
  "objects": {
    "host:local": {
      "env": {
        "LANG": "en_US.UTF-8",
        "SSL_CERT_FILE": "/oath/store/pkg/curl/live/ssl/cert.pem",
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1/bus",
        "PKG_CONFIG_PATH": "/oath/store/pkg/alsa-lib/live/lib/pkgconfig:/oath/store/pkg/at-spi2-core/live/lib/pkgconfig:/oath/store/pkg/cairo/live/lib/pkgconfig:/oath/store/pkg/cups/live/lib/pkgconfig:/oath/store/pkg/curl/live/lib/pkgconfig:/oath/store/pkg/dbus/live/lib/pkgconfig:/oath/store/pkg/elfutils/live/lib/pkgconfig:/oath/store/pkg/expat/live/lib/pkgconfig:/oath/store/pkg/fontconfig/live/lib/pkgconfig:/oath/store/pkg/freetype/live/lib/pkgconfig:/oath/store/pkg/fribidi/live/lib/pkgconfig:/oath/store/pkg/glib/live/lib/pkgconfig:/oath/store/pkg/gmp/live/lib/pkgconfig:/oath/store/pkg/harfbuzz/live/lib/pkgconfig:/oath/store/pkg/libdisplay-info/live/lib/pkgconfig:/oath/store/pkg/libdrm/live/lib/pkgconfig:/oath/store/pkg/libepoxy/live/lib/pkgconfig:/oath/store/pkg/libevdev/live/lib/pkgconfig:/oath/store/pkg/libevent/live/lib/pkgconfig:/oath/store/pkg/libffi/live/lib/pkgconfig:/oath/store/pkg/libfontenc/live/lib/pkgconfig:/oath/store/pkg/libinput/live/lib/pkgconfig:/oath/store/pkg/libpulse/live/lib/pkgconfig:/oath/store/pkg/libsndfile/live/lib/pkgconfig:/oath/store/pkg/libudev-zero/live/lib/pkgconfig:/oath/store/pkg/libx11/live/lib/pkgconfig:/oath/store/pkg/libxau/live/lib/pkgconfig:/oath/store/pkg/libxcb/live/lib/pkgconfig:/oath/store/pkg/libxcomposite/live/lib/pkgconfig:/oath/store/pkg/libxcvt/live/lib/pkgconfig:/oath/store/pkg/libxdamage/live/lib/pkgconfig:/oath/store/pkg/libxext/live/lib/pkgconfig:/oath/store/pkg/libxfixes/live/lib/pkgconfig:/oath/store/pkg/libxfont2/live/lib/pkgconfig:/oath/store/pkg/libxkbcommon/live/lib/pkgconfig:/oath/store/pkg/libxkbfile/live/lib/pkgconfig:/oath/store/pkg/libxrandr/live/lib/pkgconfig:/oath/store/pkg/libxrender/live/lib/pkgconfig:/oath/store/pkg/libxshmfence/live/lib/pkgconfig:/oath/store/pkg/libxxf86vm/live/lib/pkgconfig:/oath/store/pkg/lzo/live/lib/pkgconfig:/oath/store/pkg/mesa/live/lib/pkgconfig:/oath/store/pkg/mpc/live/lib/pkgconfig:/oath/store/pkg/mpfr/live/lib/pkgconfig:/oath/store/pkg/ncurses/live/lib/pkgconfig:/oath/store/pkg/nettle/live/lib/pkgconfig:/oath/store/pkg/nspr/live/lib/pkgconfig:/oath/store/pkg/nss/live/lib/pkgconfig:/oath/store/pkg/pango/live/lib/pkgconfig:/oath/store/pkg/pcre2/live/lib/pkgconfig:/oath/store/pkg/pipewire/live/lib/pkgconfig:/oath/store/pkg/pixman/live/lib/pkgconfig:/oath/store/pkg/procps/live/lib/pkgconfig:/oath/store/pkg/python/live/lib/pkgconfig:/oath/store/pkg/seatd/live/lib/pkgconfig:/oath/store/pkg/util-linux/live/lib/pkgconfig:/oath/store/pkg/wayland/live/lib/pkgconfig:/oath/store/pkg/wireplumber/live/lib/pkgconfig:/oath/store/pkg/wlroots/live/lib/pkgconfig:/oath/store/pkg/xcb-util-errors/live/lib/pkgconfig:/oath/store/pkg/xcb-util-wm/live/lib/pkgconfig:/oath/store/pkg/xkbcomp/live/lib/pkgconfig:/oath/store/pkg/xkeyboard-config/live/lib/pkgconfig:/oath/store/pkg/xwayland/live/lib/pkgconfig:/oath/store/pkg/xz/live/lib/pkgconfig:/oath/store/pkg/zlib/live/lib/pkgconfig:/oath/store/pkg/zstd/live/lib/pkgconfig"
      }
    },
    "svc:screen": {
      "enabled": false
    },
    "svc:seatd": {
      "exec": [
        "/bin/seatd",
        "-u",
        "home",
        "-g",
        "home"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true
    },
    "svc:rivulet": {
      "exec": [
        "/bin/rivulet",
        "-log-level",
        "info",
        "-c",
        ":"
      ],
      "wants": [
        "svc:seatd"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "LIBSEAT_BACKEND": "seatd",
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave"
      }
    },
    "svc:sola-bus": {
      "exec": [
        "/bin/sola-bus"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "SOLA_LOG_DIR": "/home/.local/state/sola",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/bash"
      }
    },
    "svc:sola-call": {
      "exec": [
        "/bin/sola-call"
      ],
      "wants": [
        "svc:sola-bus"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "SOLA_LOG_DIR": "/home/.local/state/sola",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/bash"
      }
    },
    "svc:sola-river": {
      "exec": [
        "/bin/sola-river"
      ],
      "wants": [
        "svc:rivulet",
        "svc:sola-bus",
        "svc:sola-call"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "SOLA_LOG_DIR": "/home/.local/state/sola",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/bash"
      }
    },
    "svc:sola-shell": {
      "exec": [
        "/bin/sola-shell"
      ],
      "wants": [
        "svc:sola-river",
        "svc:pipewire-pulse",
        "svc:wireplumber"
      ],
      "restart": "on-failure",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "SOLA_LOG_DIR": "/home/.local/state/sola",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/bash"
      }
    },
    "svc:sola-session": {
      "exec": [
        "/bin/sola-session"
      ],
      "wants": [
        "svc:sola-bus",
        "svc:sola-call"
      ],
      "restart": "on-failure",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "SOLA_LOG_DIR": "/home/.local/state/sola",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/bash"
      }
    },
    "svc:dbus-session": {
      "exec": [
        "/bin/dbus-daemon",
        "--session",
        "--nofork",
        "--nopidfile",
        "--address=unix:path=/run/user/1/bus"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true,
      "user": "home"
    },
    "svc:sola-kvm": {
      "exec": [
        "/bin/sola-kvm",
        "listen",
        "--bind",
        "0.0.0.0:4242"
      ],
      "wants": [
        "svc:sola-river"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home",
      "env": {
        "XCURSOR_PATH": "/oath/store/pkg/sola/share/cursors",
        "XCURSOR_THEME": "McMojave",
        "SOLA_LOG_DIR": "/home/.local/state/sola",
        "FONTCONFIG_FILE": "/oath/store/pkg/fontconfig/live/etc/fonts/fonts.conf",
        "SHELL": "/bin/bash"
      }
    },
    "svc:pipewire": {
      "exec": [
        "/bin/pipewire"
      ],
      "wants": [
        "svc:dbus-session"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home"
    },
    "svc:wireplumber": {
      "exec": [
        "/bin/wireplumber"
      ],
      "wants": [
        "svc:pipewire"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home"
    },
    "svc:pipewire-pulse": {
      "exec": [
        "/bin/pipewire-pulse"
      ],
      "wants": [
        "svc:pipewire"
      ],
      "restart": "always",
      "enabled": true,
      "user": "home"
    },
