{
  "fixed": ["pkg:busybox", "pkg:btrfs", "pkg:oath", "pkg:dropbear"],
  "objects": {
    "host:local": { "hostname": "oath", "power": "run" },
    "svc:serial": {
      "exec": ["/lib/oath/serial-login"],
      "wants": [],
      "restart": "always",
      "enabled": true
    },
    "svc:sshd": {
      "exec": ["/bin/dropbear", "-F", "-E", "-s", "-w", "-r", "/oath/ssh/host_ed25519", "-p", "22"],
      "wants": [],
      "restart": "always",
      "enabled": true
    },
    "svc:hold": {
      "exec": ["/bin/sleep", "86400000"],
      "wants": ["svc:serial"],
      "restart": "always",
      "enabled": true
    },
    "pkg:busybox": {
      "present": true,
      "description": "Unix applets in one musl ELF, including vi.",
      "home": "https://busybox.net/"
    },
    "pkg:btrfs": {
      "present": true,
      "description": "btrfs-progs for the live @ generations.",
      "home": "https://btrfs.readthedocs.io/"
    },
    "pkg:oath": {
      "present": true,
      "description": "Catalog CLI — the only admin surface.",
      "home": "https://github.com/moonlight-pm/oath"
    },
    "pkg:dropbear": {
      "present": true,
      "description": "SSH server and musl OpenSSH client bits.",
      "home": "https://matt.ucc.asn.au/dropbear/dropbear.html"
    },
    "pkg:curl": {
      "present": true,
      "description": "curl with a CA bundle.",
      "home": "https://curl.se/"
    },
    "pkg:hello": {
      "present": false,
      "description": "Canary ELF. /bin/hello prints hello.",
      "home": "https://github.com/moonlight-pm/oath"
    },
    "pkg:fetchme": {
      "present": false,
      "url": "http://10.0.2.2:18765/fetchme",
      "description": "Canary fetch into the store from the QEMU host.",
      "home": "https://github.com/moonlight-pm/oath"
    },
    "ssh:local": { "authorized": [] },
    "net:net0": { "up": true, "ipv4": "dhcp", "gateway": "", "lease": null },
    "dev:vda": { "present": true },
    "dev:net0": { "present": true },
    "dev:ttyS0": { "present": true },
    "snap:current": { "generation": 0 }
  },
  "actual": {
    "dev:vda": { "present": true, "class": "block", "node": "/dev/vda" },
    "dev:net0": { "present": true, "class": "net", "node": "/sys/class/net/net0" },
    "dev:ttyS0": { "present": true, "class": "tty", "node": "/dev/ttyS0" }
  }
}
