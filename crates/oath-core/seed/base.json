{
  "fixed": ["pkg:busybox", "pkg:btrfs", "pkg:oath", "pkg:dropbear"],
  "objects": {
    "host:local": { "hostname": "oath", "power": "run" },
    "svc:serial": {
      "exec": ["/lib/oath/serial-login"],
      "wants": [],
      "restart": "always",
      "enabled": true
    },
    "svc:screen": {
      "exec": ["/lib/oath/screen-login"],
      "wants": [],
      "restart": "always",
      "enabled": true,
      "user": "home"
    },
    "svc:sshd": {
      "exec": ["/bin/dropbear", "-F", "-E", "-s", "-w", "-r", "/oath/ssh/host_ed25519", "-p", "22"],
      "wants": [],
      "restart": "always",
      "enabled": true,
      "keep_children": true
    },
    "svc:time": {
      "exec": [
        "/bin/ntpd", "-n", "-S", "/lib/oath/ntp-event",
        "-p", "0.pool.ntp.org", "-p", "1.pool.ntp.org", "-p", "2.pool.ntp.org", "-p", "3.pool.ntp.org"
      ],
      "wants": [],
      "restart": "always",
      "enabled": true
    },
    "pkg:busybox": {
      "present": true,
      "description": "Unix applets in one musl ELF, including vi.",
      "home": "https://busybox.net/"
    },
    "pkg:btrfs": {
      "present": true,
      "description": "btrfs-progs for the live @ generations.",
      "home": "https://btrfs.readthedocs.io/"
    },
    "pkg:oath": {
      "present": true,
      "description": "Catalog CLI — the only admin surface.",
      "home": "https://github.com/moonlight-pm/oath"
    },
    "pkg:dropbear": {
      "present": true,
      "description": "Dropbear SSH server and dropbearkey.",
      "home": "https://matt.ucc.asn.au/dropbear/dropbear.html"
    },
    "pkg:openssh": {
      "present": true,
      "description": "OpenSSH client tools: ssh, scp, sftp, ssh-keygen, and sftp-server for dropbear. Built without OpenSSL (ed25519).",
      "home": "https://www.openssh.com/portable.html"
    },
    "pkg:util-linux": {
      "present": true,
      "description": "Disk tools (sfdisk, wipefs, blkid, lsblk) and libuuid, libblkid, libfdisk, libmount.",
      "home": "https://github.com/util-linux/util-linux"
    },
    "pkg:dosfstools": {
      "present": true,
      "description": "mkfs.fat and fsck.fat for the EFI system partition.",
      "home": "https://github.com/dosfstools/dosfstools"
    },
    "pkg:curl": {
      "present": true,
      "description": "curl over Mbed TLS, with Mozilla's CA bundle (curl.se/ca).",
      "home": "https://curl.se/"
    },
    "ssh:local": { "authorized": [] },
    "net:net0": { "up": true, "ipv4": "dhcp", "gateway": "", "lease": null },
    "snap:current": { "generation": 0 }
  }
}
