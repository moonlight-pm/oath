{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oath:kind:ssh",
  "title": "ssh",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorized"],
  "properties": {
    "authorized": {
      "type": "array",
      "items": { "type": "string" },
      "description": "OpenSSH public key lines for root. Empty means nobody can log in. No passwords. No baked private key."
    }
  }
}
